---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import RequestForm from '../components/RequestForm.astro';
import { events } from '../data/content';
import { u } from '../lib/url';
import { dateLong, time } from '../lib/format';
const openNight = events.find((e) => e.slug.startsWith('vidkrytyi-vechir'));
---
<Base title="Приєднатися" description="Як стати членом Lions Club Lviv Leopolis або волонтером клубу.">
  <PageHead title="Як долучитися до клубу" lead="Членство в Lions за рекомендацією чинного члена клубу. Почати можна з простого: прийти на зустріч або допомогти волонтером. Зустрічі проходять англійською." />
  <section class="wrap pb-16">
    <ol class="grid gap-8 md:grid-cols-3">
      {[
        ['Прийдіть на відкритий вечір', openNight ? `Найближчий: ${dateLong(openNight.start)}, ${time(openNight.start)}.` : 'Дату оголосимо в розділі «Події».'],
        ['Спробуйте служіння', 'Долучіться волонтером до одного з проєктів, щоб відчути, як ми працюємо.'],
        ['Отримайте рекомендацію', 'Член клубу рекомендує вас, правління погоджує, і ви складаєте присягу Lions.'],
      ].map(([t, d], i) => (
        <li class="panel p-7">
          <p class="t-num text-[44px] font-[780] leading-none tracking-[-0.04em] text-accent" style="font-stretch:118%">{i + 1}</p>
          <p class="mt-4 text-[21px] font-[650] tracking-[-0.015em]">{t}</p>
          <p class="mt-2 text-soft">{d}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="section-tight bg-alt">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1.3fr]">
      <div class="space-y-4">
        <h2 class="t-h2">Залиште заявку</h2>
        <p class="t-lead">Розкажіть коротко про себе і що вам цікаво: членство, волонтерство чи партнерство.</p>
        <p class="text-soft">Членський внесок і очікування від членів клубу пояснимо на першій зустрічі.</p>
        {openNight && <a href={u(`/events/${openNight.slug}`)} class="link inline-block">Про відкритий вечір</a>}
      </div>
      <RequestForm kind="join" submitLabel="Надіслати заявку" messageLabel="Про себе і чим хочете долучитися" />
    </div>
  </section>
</Base>
