---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { events } from '../../data/content';
import { club } from '../../data/site';
import { u } from '../../lib/url';
import { dayNum, monthShort, weekday, time, dateLong } from '../../lib/format';

const now = new Date('2026-11-26T12:00:00+02:00'); // демо-"сьогодні"
const upcoming = events.filter((e) => new Date(e.start) >= now).sort((a, b) => a.start.localeCompare(b.start));
const past = events.filter((e) => new Date(e.start) < now).sort((a, b) => b.start.localeCompare(a.start));

const monthKey = (iso: string) => iso.slice(0, 7);
const groups = Object.entries(Object.groupBy(upcoming, (e) => monthKey(e.start)));
const monthTitle = (key: string) => new Intl.DateTimeFormat('uk-UA', { month: 'long', year: 'numeric' }).format(new Date(`${key}-15`));

// Сітка календаря: понеділок перший
function grid(key: string) {
  const [y, m] = key.split('-').map(Number);
  const first = new Date(Date.UTC(y, m - 1, 1));
  const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const lead = (first.getUTCDay() + 6) % 7;
  return [...Array(lead).fill(null), ...Array.from({ length: days }, (_, i) => i + 1)];
}
const kindLabel = { meeting: 'Збори', service: 'Служіння', gala: 'Благодійний вечір' } as const;
---
<Base title="Події" description="Розклад зустрічей і подій Lviv International Lions Club.">
  <PageHead title="Події та зустрічі" lead={`${club.meetingRule}. Відкриті події доступні всім, збори клубу бачать члени після входу.`}>
    <div class="mt-8 flex flex-wrap gap-3">
      <div class="inline-flex rounded-full bg-[var(--bg-alt)] p-1" role="tablist" aria-label="Вигляд">
        <button class="btn btn-sm bg-[var(--surface)] shadow-sm" role="tab" aria-selected="true" data-view="list">Список</button>
        <button class="btn btn-sm" role="tab" aria-selected="false" data-view="cal">Календар</button>
      </div>
      <a href={u('/events.ics')} class="btn btn-quiet btn-sm">Підписатися на календар</a>
    </div>
  </PageHead>

  <section class="wrap pb-24" data-pane="list">
    <p class="panel mb-10 p-5 text-[15px]" data-members-note hidden>
      У розкладі є зустрічі лише для членів клубу. <a class="link" href={u('/login')}>Увійдіть</a>, щоб їх бачити.
    </p>
    <div data-local-events></div>
    {groups.map(([key, list]) => (
      <div class="mb-14">
        <h2 class="t-h3 mb-4 first-letter:uppercase">{monthTitle(key)}</h2>
        <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {list!.map((e) => (
            <li data-visibility={e.visibility}>
              <a href={u(`/events/${e.slug}`)} class="group grid grid-cols-[72px_1fr] gap-5 py-6 md:grid-cols-[96px_1fr_auto] md:items-center md:gap-8">
                <div class="leading-none">
                  <p class="t-num text-[44px] font-[760] tracking-[-0.04em]" style="font-stretch:118%">{dayNum(e.start)}</p>
                  <p class="t-small mt-1">{monthShort(e.start)}, {weekday(e.start).slice(0, 2)}</p>
                </div>
                <div class="space-y-1">
                  <p class="flex flex-wrap items-center gap-2">
                    <span class="text-[21px] font-[650] tracking-[-0.015em] group-hover:text-[var(--accent)]">{e.title}</span>
                    {e.visibility === 'members' && <span class="badge">для членів клубу</span>}
                    {e.demo && <span class="badge badge-gold">демо</span>}
                  </p>
                  <p class="text-soft">{e.timeUnknown ? '' : `${time(e.start)}. `}{e.location}</p>
                </div>
                <span class="badge badge-blue col-start-2 w-fit md:col-start-auto">{kindLabel[e.kind]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <h2 class="t-h3 mb-4 mt-20">Минулі події</h2>
    <ul class="grid gap-2">
      {past.map((e) => <li><a class="link" href={u(`/events/${e.slug}`)}>{e.title}</a> <span class="text-soft">{dateLong(e.start)}</span></li>)}
    </ul>
  </section>

  <section class="wrap grid gap-14 pb-24 lg:grid-cols-2" data-pane="cal" hidden>
    {groups.map(([key, list]) => (
      <div>
        <h2 class="t-h3 mb-5 first-letter:uppercase">{monthTitle(key)}</h2>
        <div class="grid grid-cols-7 gap-1 text-center text-[13px] text-soft">
          {['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Нд'].map((d) => <span class="py-2">{d}</span>)}
        </div>
        <div class="grid grid-cols-7 gap-1">
          {grid(key).map((d) => {
            const hits = d ? list!.filter((e) => Number(dayNum(e.start)) === d) : [];
            return d ? (
              <div class={`min-h-[78px] rounded-xl p-2 text-left ${hits.length ? 'bg-[var(--bg-alt)]' : ''}`}>
                <p class={`t-num text-[15px] ${hits.length ? 'font-[700]' : 'text-soft'}`}>{d}</p>
                {hits.map((e) => (
                  <a href={u(`/events/${e.slug}`)} data-visibility={e.visibility} class={`mt-1 block truncate rounded-md px-1.5 py-0.5 text-[12px] font-[560] ${e.visibility === 'members' ? 'bg-[var(--line)]' : 'bg-[var(--color-lions)] text-white'}`} title={e.title}>{e.title}</a>
                ))}
              </div>
            ) : <div />;
          })}
        </div>
      </div>
    ))}
  </section>
</Base>

<script>
  import { getUser, can, demoEvents, esc } from '../../scripts/store';
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-view]');
    if (!tabs.length) return;
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.classList.toggle('bg-[var(--surface)]', on); x.classList.toggle('shadow-sm', on); });
      document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== t.dataset.view));
    }));
    const member = can.memberArea(getUser());
    let hiddenCount = 0;
    document.querySelectorAll<HTMLElement>('[data-visibility="members"]').forEach((el) => { el.hidden = !member; if (!member) hiddenCount++; });
    const note = document.querySelector<HTMLElement>('[data-members-note]');
    if (note) note.hidden = member || hiddenCount === 0;
    const local = demoEvents().filter((e) => e.visibility === 'public' || member);
    const box = document.querySelector<HTMLElement>('[data-local-events]');
    if (box) box.innerHTML = local.length ? `<div class="mb-14"><h2 class="t-h3 mb-4">Додано в адмінці</h2><ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">${local.map((e) => `
      <li class="py-6"><p class="text-[21px] font-[650]">${esc(e.title)} <span class="badge badge-gold ml-2">демо</span></p>
      <p class="text-soft">${new Intl.DateTimeFormat('uk-UA', { dateStyle: 'long', timeStyle: 'short' }).format(new Date(e.start))}. ${esc(e.location)}</p></li>`).join('')}</ul></div>` : '';
  });
</script>
