---
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { news } from '../../data/content';
export function getStaticPaths() {
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const more = news.filter((n) => n.slug !== post.slug).slice(0, 3);
const ld = { '@context': 'https://schema.org', '@type': 'NewsArticle', headline: post.title, datePublished: post.date, description: post.excerpt, publisher: { '@type': 'NGO', name: 'Lions Club Leopolis' } };
---
<Base title={post.title} description={post.excerpt} jsonLd={ld}>
  <PostArticle post={post} back={{ href: '/news', label: 'Усі новини' }} more={more} />
</Base>
