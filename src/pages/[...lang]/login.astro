---
import Base from '../../layouts/Base.astro';
import { langPaths, langOf, t } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
---
<Base title={T.signIn} noindex>
  <section class="wrap grid gap-12 pb-24 pt-[clamp(3rem,7vw,6rem)] lg:grid-cols-[1fr_1fr]">
    <div class="space-y-5">
      <h1 class="t-h1">{T.signIn}</h1>
      <p class="t-lead max-w-[36ch]">{s('No passwords: enter your email and we will send you a sign-in link.', 'Без паролів: введіть email, і ми надішлемо посилання для входу.')}</p>
      <p class="text-soft max-w-[44ch]">{s('Club members and editors get their access automatically after the first sign-in, if the admin has added their email.', 'Члени клубу й редактори отримують доступ автоматично після першого входу, якщо адмін додав їхній email.')}</p>
    </div>
    <div class="panel p-6 sm:p-8 md:p-10">
      <div data-current hidden class="space-y-4">
        <p class="text-[17px]" data-who></p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-blue" data-go></a>
          <button type="button" class="btn btn-ghost" data-out>{s('Sign out', 'Вийти')}</button>
        </div>
      </div>
      <form class="grid gap-4" data-login novalidate>
        <div class="field"><label for="ml">Email</label><input id="ml" name="email" class="input" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" required /></div>
        <button class="btn btn-blue w-full sm:w-auto" type="submit">{s('Send sign-in link', 'Надіслати посилання для входу')}</button>
        <p class="text-[15px]" role="status" data-status></p>
      </form>
    </div>
  </section>
</Base>
<script>
  import { getProfile, signInWithEmail, signOut, can, displayName } from '../../scripts/api';
  import { ct, cprefix } from '../../scripts/i18n';
  async function paint() {
    const box = document.querySelector<HTMLElement>('[data-current]');
    const form = document.querySelector<HTMLFormElement>('[data-login]');
    if (!box || !form) return;
    const p = await getProfile();
    box.hidden = !p; form.hidden = !!p;
    if (p) {
      box.querySelector('[data-who]')!.innerHTML = `${ct().current}: <b></b> (${ct().roles[p.role]})`;
      box.querySelector('[data-who] b')!.textContent = displayName(p);
      const go = box.querySelector<HTMLAnchorElement>('[data-go]')!;
      go.href = `${cprefix()}${can.admin(p) ? '/admin' : '/account'}`;
      go.textContent = can.admin(p) ? ct().admin : ct().account;
    }
  }
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-login]');
    if (!form) return;
    paint();
    document.querySelector<HTMLButtonElement>('[data-out]')!.onclick = async () => { await signOut(); paint(); };
    form.onsubmit = async (e) => {
      e.preventDefault();
      const st = form.querySelector<HTMLElement>('[data-status]')!;
      const email = String(new FormData(form).get('email') || '').trim();
      if (!form.checkValidity() || !email) { form.reportValidity(); return; }
      const btn = form.querySelector<HTMLButtonElement>('button')!; btn.disabled = true;
      try {
        await signInWithEmail(email, `${location.origin}${cprefix()}/account/`);
        st.className = 'text-[15px] text-[#067647]'; st.textContent = ct().linkSent(email);
      } catch (err) {
        st.className = 'text-[15px] text-[#b42318]'; st.textContent = `${ct().linkError} (${(err as Error).message})`;
      } finally { btn.disabled = false; }
    };
  });
  window.addEventListener('llp:change', paint);
</script>
