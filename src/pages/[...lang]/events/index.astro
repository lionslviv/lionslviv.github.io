---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { events, kindLabel } from '../../../data/content';
import { club } from '../../../data/site';
import { u } from '../../../lib/url';
import { dayNum, monthShort, weekday, time, dateLong, monthTitle } from '../../../lib/format';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);

const now = new Date('2026-11-26T12:00:00+02:00'); // демо-"сьогодні"
const upcoming = events.filter((e) => new Date(e.start) >= now).sort((a, b) => a.start.localeCompare(b.start));
const past = events.filter((e) => new Date(e.start) < now).sort((a, b) => b.start.localeCompare(a.start));

const monthKey = (iso: string) => iso.slice(0, 7);
const groups = Object.entries(Object.groupBy(upcoming, (e) => monthKey(e.start)));
const wd = (iso: string) => (lang === 'uk' ? weekday(iso, lang).slice(0, 2) : weekday(iso, lang).slice(0, 3));
const days = lang === 'uk' ? ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Нд'] : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

// Сітка календаря: понеділок перший
function grid(key: string) {
  const [y, m] = key.split('-').map(Number);
  const first = new Date(Date.UTC(y, m - 1, 1));
  const n = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const lead = (first.getUTCDay() + 6) % 7;
  return [...Array(lead).fill(null), ...Array.from({ length: n }, (_, i) => i + 1)];
}
---
<Base title={T.nav.events} description={s('Meetings and events of Lviv International Lions Club.', 'Розклад зустрічей і подій Lviv International Lions Club.')}>
  <PageHead title={s('Events and meetings', 'Події та зустрічі')} lead={`${tr(lang, club.meetingRule)}. ${s('Open events are for everyone; club meetings are visible to members after signing in.', 'Відкриті події доступні всім, збори клубу бачать члени після входу.')}`}>
    <div class="mt-8 flex flex-wrap gap-3">
      <div class="inline-flex rounded-full bg-[var(--bg-alt)] p-1" role="tablist" aria-label={s('View', 'Вигляд')}>
        <button class="btn btn-sm bg-[var(--surface)] shadow-sm" role="tab" aria-selected="true" data-view="list">{s('List', 'Список')}</button>
        <button class="btn btn-sm" role="tab" aria-selected="false" data-view="cal">{s('Calendar', 'Календар')}</button>
      </div>
      <a href={u(lang === 'uk' ? '/uk/events.ics' : '/events.ics')} class="btn btn-quiet btn-sm">{s('Subscribe to calendar', 'Підписатися на календар')}</a>
    </div>
  </PageHead>

  <section class="wrap pb-24" data-pane="list">
    <p class="panel mb-10 p-5 text-[15px]" data-members-note hidden>
      {s('The schedule includes members-only meetings.', 'У розкладі є зустрічі лише для членів клубу.')} <a class="link" href={lp(lang, '/login')}>{T.signIn}</a> {s('to see them.', ', щоб їх бачити.')}
    </p>
    <div data-local-events></div>
    {groups.map(([key, list]) => (
      <div class="mb-14">
        <h2 class="t-h3 mb-4 first-letter:uppercase">{monthTitle(key, lang)}</h2>
        <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {list!.map((e) => (
            <li data-visibility={e.visibility}>
              <a href={lp(lang, `/events/${e.slug}`)} class="group grid grid-cols-[72px_1fr] gap-5 py-6 md:grid-cols-[96px_1fr_auto] md:items-center md:gap-8">
                <div class="leading-none">
                  <p class="t-num text-[44px] font-[760] tracking-[-0.04em]" style="font-stretch:118%">{dayNum(e.start, lang)}</p>
                  <p class="t-small mt-1">{monthShort(e.start, lang)}, {wd(e.start)}</p>
                </div>
                <div class="space-y-1">
                  <p class="flex flex-wrap items-center gap-2">
                    <span class="text-[21px] font-[650] tracking-[-0.015em] group-hover:text-[var(--accent)]">{tr(lang, e.title)}</span>
                    {e.visibility === 'members' && <span class="badge">{T.forMembers}</span>}
                    {e.demo && <span class="badge badge-gold">{T.demo}</span>}
                  </p>
                  <p class="text-soft">{e.timeUnknown ? '' : `${time(e.start, lang)}. `}{tr(lang, e.location)}</p>
                </div>
                <span class="badge badge-blue col-start-2 w-fit md:col-start-auto">{tr(lang, kindLabel[e.kind])}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <h2 class="t-h3 mb-4 mt-20">{s('Past events', 'Минулі події')}</h2>
    <ul class="grid gap-2">
      {past.map((e) => <li><a class="link" href={lp(lang, `/events/${e.slug}`)}>{tr(lang, e.title)}</a> <span class="text-soft">{dateLong(e.start, lang)}</span></li>)}
    </ul>
  </section>

  <section class="wrap grid gap-14 pb-24 lg:grid-cols-2" data-pane="cal" hidden>
    {groups.map(([key, list]) => (
      <div>
        <h2 class="t-h3 mb-5 first-letter:uppercase">{monthTitle(key, lang)}</h2>
        <div class="grid grid-cols-7 gap-1 text-center text-[13px] text-soft">
          {days.map((d) => <span class="py-2">{d}</span>)}
        </div>
        <div class="grid grid-cols-7 gap-1">
          {grid(key).map((d) => {
            const hits = d ? list!.filter((e) => Number(dayNum(e.start, lang)) === d) : [];
            return d ? (
              <div class={`min-h-[78px] rounded-xl p-2 text-left ${hits.length ? 'bg-[var(--bg-alt)]' : ''}`}>
                <p class={`t-num text-[15px] ${hits.length ? 'font-[700]' : 'text-soft'}`}>{d}</p>
                {hits.map((e) => (
                  <a href={lp(lang, `/events/${e.slug}`)} data-visibility={e.visibility} class={`mt-1 block truncate rounded-md px-1.5 py-0.5 text-[12px] font-[560] ${e.visibility === 'members' ? 'bg-[var(--line)]' : 'bg-[var(--color-lions)] text-white'}`} title={tr(lang, e.title)}>{tr(lang, e.title)}</a>
                ))}
              </div>
            ) : <div />;
          })}
        </div>
      </div>
    ))}
  </section>
</Base>

<script>
  import { getUser, can, demoEvents, esc } from '../../../scripts/store';
  import { ct, clang } from '../../../scripts/i18n';
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-view]');
    if (!tabs.length) return;
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.classList.toggle('bg-[var(--surface)]', on); x.classList.toggle('shadow-sm', on); });
      document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== t.dataset.view));
    }));
    const member = can.memberArea(getUser());
    let hiddenCount = 0;
    document.querySelectorAll<HTMLElement>('[data-visibility="members"]').forEach((el) => { el.hidden = !member; if (!member) hiddenCount++; });
    const note = document.querySelector<HTMLElement>('[data-members-note]');
    if (note) note.hidden = member || hiddenCount === 0;
    const local = demoEvents().filter((e) => e.visibility === 'public' || member);
    const fmt = new Intl.DateTimeFormat(clang() === 'uk' ? 'uk-UA' : 'en-GB', { dateStyle: 'long', timeStyle: 'short' });
    const box = document.querySelector<HTMLElement>('[data-local-events]');
    if (box) box.innerHTML = local.length ? `<div class="mb-14"><h2 class="t-h3 mb-4">${ct().addedInAdmin}</h2><ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">${local.map((e) => `
      <li class="py-6"><p class="text-[21px] font-[650]">${esc(e.title)} <span class="badge badge-gold ml-2">${ct().demo}</span></p>
      <p class="text-soft">${fmt.format(new Date(e.start))}. ${esc(e.location)}</p></li>`).join('')}</ul></div>` : '';
  });
</script>
