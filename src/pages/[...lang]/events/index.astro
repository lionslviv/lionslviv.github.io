---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { kindLabel } from '../../../data/content';
import { events, albums } from '../../../data/live';
import { club } from '../../../data/site';
import { u } from '../../../lib/url';
import { dayNum, monthShort, weekday, time, monthTitle } from '../../../lib/format';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);

const now = new Date(); // час збірки; сайт перезбирається за розкладом
const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start));
const upcoming = sorted.filter((e) => new Date(e.start) >= now);
const past = sorted.filter((e) => new Date(e.start) < now).reverse();
const albumOf = (slug: string) => albums.find((a) => a.eventSlug === slug);

const monthKey = (iso: string) => iso.slice(0, 7);
const groups = Object.entries(Object.groupBy(upcoming, (e) => monthKey(e.start)));
// У календарі показуємо всі місяці з подіями, і минулими, і майбутніми
// Дні народження: найближчі 12 місяців, а в минулих місяцях лише ті, де були події.
// Сайт перезбирається кожні 30 хвилин, тож вікно рухається разом з часом.
const thisMonth = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Kyiv' }).format(now).slice(0, 7);
const eventMonths = new Set(sorted.map((e) => monthKey(e.start)));
const calStart = [sorted[0] ? monthKey(sorted[0].start) : thisMonth, thisMonth].sort()[0];
const birthdays = birthdaysBetween(calStart, addMonths(thisMonth, 11)).filter((b) => b.date.slice(0, 7) >= thisMonth || eventMonths.has(b.date.slice(0, 7)));
const bdOf = (key: string) => birthdays.filter((b) => b.date.startsWith(key));
const calMonths = [...new Set([...sorted.map((e) => monthKey(e.start)), ...birthdays.map((b) => b.date.slice(0, 7))])]
  .sort()
  .map((key) => [key, sorted.filter((e) => monthKey(e.start) === key)] as const);
const [ty, tm, td] = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Kyiv' }).format(now).split('-').map(Number);
const todayKey = { y: ty, m: tm, d: td };
const wd = (iso: string) => (lang === 'uk' ? weekday(iso, lang).slice(0, 2) : weekday(iso, lang).slice(0, 3));
const days = lang === 'uk' ? ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Нд'] : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

// Сітка календаря: понеділок перший
function grid(key: string) {
  const [y, m] = key.split('-').map(Number);
  const first = new Date(Date.UTC(y, m - 1, 1));
  const n = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const lead = (first.getUTCDay() + 6) % 7;
  return [...Array(lead).fill(null), ...Array.from({ length: n }, (_, i) => i + 1)];
}

// Підписка на календар: webcal для Apple/Outlook, cid для Google Calendar
const icsPath = u(lang === 'uk' ? '/uk/events.ics' : '/events.ics');
const icsAbs = new URL(icsPath, Astro.site).toString();
const webcal = icsAbs.replace(/^https?:/, 'webcal:');
const googleSub = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`;
const when = (e: (typeof events)[number]) => (e.timeUnknown ? s('Time to be confirmed', 'Час уточнюється') : time(e.start, lang));
import { birthdaysBetween, addMonths } from '../../../lib/birthdays';
---
<Base title={T.nav.events} description={s('Meetings and events of Lviv International Lions Club.', 'Розклад зустрічей і подій Lviv International Lions Club.')}>
  <PageHead title={s('Events and meetings', 'Події та зустрічі')} lead={s(`Our meetings are held in English at ${tr('en', club.meetingPlace)}. Guests are welcome: write to us before you come.`, `Зустрічі проходять англійською в готелі Leopolis, вул. Театральна, 16, Львів. Гості запрошені: напишіть нам перед візитом.`)}>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <div class="inline-flex rounded-full bg-[var(--bg-alt)] p-1" role="tablist" aria-label={s('View', 'Вигляд')}>
        <button type="button" class="btn btn-sm bg-[var(--surface)] shadow-sm" role="tab" aria-selected="true" aria-controls="pane-list" data-view="list">{s('List', 'Список')}</button>
        <button type="button" class="btn btn-sm" role="tab" aria-selected="false" aria-controls="pane-cal" data-view="cal">{s('Calendar', 'Календар')}</button>
      </div>
      <details class="relative" data-sub>
        <summary class="btn btn-quiet btn-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden">{s('Subscribe to calendar', 'Підписатися на календар')}</summary>
        <div class="absolute left-0 z-20 mt-2 grid w-[min(18rem,calc(100vw-2.5rem))] gap-1 rounded-2xl bg-[var(--surface)] p-2 shadow-lg ring-1 ring-[var(--line)]">
          <a href={googleSub} target="_blank" rel="noopener" class="rounded-xl px-3 py-3 text-[15px] font-[560] hover:bg-[var(--bg-alt)]">Google Calendar</a>
          <a href={webcal} class="rounded-xl px-3 py-3 text-[15px] font-[560] hover:bg-[var(--bg-alt)]">{s('Apple Calendar / Outlook', 'Apple Calendar / Outlook')}</a>
          <a href={icsPath} download class="rounded-xl px-3 py-3 text-[15px] font-[560] hover:bg-[var(--bg-alt)]">{s('Download .ics file', 'Завантажити файл .ics')}</a>
        </div>
      </details>
    </div>
  </PageHead>

  <section id="pane-list" class="wrap pb-24" data-pane="list" role="tabpanel">
    <p class="panel mb-10 p-5 text-[15px]" data-members-note hidden>
      {s('The schedule includes members-only meetings.', 'У розкладі є зустрічі лише для членів клубу.')} <a class="link" href={lp(lang, '/login')}>{T.signIn}</a> {s('to see them.', ', щоб їх бачити.')}
    </p>
    <div data-local-events data-known={JSON.stringify(events.map((e) => e.slug))}></div>
    {groups.length === 0 && <p class="t-lead mb-14">{s('New meetings will be announced here soon.', 'Нові зустрічі скоро з’являться тут.')}</p>}
    {groups.map(([key, list]) => (
      <div class="mb-14">
        <h2 class="t-h3 mb-4 first-letter:uppercase">{monthTitle(key, lang)}</h2>
        <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {list!.map((e) => (
            <li data-visibility={e.visibility}>
              <a href={lp(lang, `/events/${e.slug}`)} class="group grid grid-cols-[72px_1fr] gap-5 py-6 md:grid-cols-[96px_1fr_auto] md:items-center md:gap-8">
                <div class="leading-none">
                  <p class="t-num text-[44px] font-[760] tracking-[-0.04em]" style="font-stretch:118%">{dayNum(e.start, lang)}</p>
                  <p class="t-small mt-1">{monthShort(e.start, lang)}, {wd(e.start)}</p>
                </div>
                <div class="space-y-1">
                  <p class="flex flex-wrap items-center gap-2">
                    <span class="text-[21px] font-[650] tracking-[-0.015em] group-hover:text-[var(--accent)]">{tr(lang, e.title)}</span>
                    {e.visibility === 'members' && <span class="badge">{T.forMembers}</span>}
                    {e.demo && <span class="badge badge-gold">{T.demo}</span>}
                  </p>
                  <p class="text-soft">{when(e)}. {tr(lang, e.location)}</p>
                  <p class="hidden max-w-[60ch] pt-1 text-[15px] text-soft md:block">{tr(lang, e.description)}</p>
                </div>
                <span class="badge badge-blue col-start-2 w-fit md:col-start-auto">{tr(lang, kindLabel[e.kind])}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    {past.length > 0 && (
      <div>
        <h2 class="t-h3 mb-4 mt-20">{s('Past meetings', 'Минулі зустрічі')}</h2>
        <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {past.map((e) => {
            const al = albumOf(e.slug);
            const cover = al?.photos[0];
            return (
              <li>
                <a href={lp(lang, `/events/${e.slug}`)} class="group grid grid-cols-[72px_1fr] items-center gap-5 py-5 md:grid-cols-[96px_1fr_auto] md:gap-8">
                  <div class="leading-none text-soft">
                    <p class="t-num text-[34px] font-[720] tracking-[-0.03em]">{dayNum(e.start, lang)}</p>
                    <p class="t-small mt-1">{monthShort(e.start, lang)}, {wd(e.start)}</p>
                  </div>
                  <div>
                    <p class="text-[19px] font-[620] group-hover:text-[var(--accent)]">{tr(lang, e.title)}</p>
                    <p class="t-small mt-1">{tr(lang, e.location)}{al ? ` · ${al.photos.length} ${T.photos}` : ''}</p>
                  </div>
                  {cover?.src && <img src={u(cover.src)} alt="" width="160" height="110" loading="lazy" decoding="async" class="col-start-2 h-[72px] w-[108px] rounded-xl object-cover md:col-start-auto md:h-[88px] md:w-[132px]" />}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>

  <section id="pane-cal" class="wrap grid gap-14 pb-24 lg:grid-cols-2" data-pane="cal" role="tabpanel" hidden>
    {calMonths.map(([key, list]) => {
      const [y, m] = key.split('-').map(Number);
      return (
        <div>
          <h2 class="t-h3 mb-5 first-letter:uppercase">{monthTitle(key, lang)}</h2>
          <div class="grid grid-cols-7 gap-1 text-center text-[13px] text-soft">
            {days.map((d) => <span class="py-2">{d}</span>)}
          </div>
          <div class="grid grid-cols-7 gap-1">
            {grid(key).map((d) => {
              const hits = d ? list!.filter((e) => Number(dayNum(e.start, lang)) === d) : [];
              const bds = d ? bdOf(key).filter((b) => Number(b.date.slice(8)) === d) : [];
              const isToday = d === todayKey.d && m === todayKey.m && y === todayKey.y;
              return d ? (
                <div class={`relative min-h-[48px] rounded-xl p-1.5 text-left sm:min-h-[84px] sm:p-2 ${hits.length || bds.length ? 'bg-[var(--bg-alt)]' : ''} ${isToday ? 'ring-2 ring-[var(--color-gold)]' : ''}`}>
                  <p class={`t-num text-[15px] ${hits.length || bds.length ? 'font-[700]' : 'text-soft'}`}>{d}</p>
                  {hits.map((e) => {
                    const isPast = new Date(e.start) < now;
                    const tone = e.visibility === 'members' ? 'bg-[var(--line)]' : isPast ? 'bg-[var(--color-lions-sky)] text-white' : 'bg-[var(--color-lions)] text-white';
                    return (
                      <a href={lp(lang, `/events/${e.slug}`)} data-visibility={e.visibility} class="block" title={tr(lang, e.title)} aria-label={tr(lang, e.title)}>
                        <span class={`absolute inset-0 sm:hidden`} aria-hidden="true"></span>
                        <span class={`mt-1 block h-1.5 w-1.5 rounded-full sm:hidden ${isPast ? 'bg-[var(--color-lions-sky)]' : 'bg-[var(--color-lions)]'}`} aria-hidden="true"></span>
                        <span class={`mt-1 hidden rounded-md px-1.5 py-1 text-[12px] font-[560] leading-[1.2] [overflow-wrap:anywhere] sm:block ${tone}`}>{tr(lang, e.title)}</span>
                      </a>
                    );
                  })}
                  {bds.map((b) => (
                    <a href={lp(lang, `/members/${b.slug}`)} class="block" title={`${s('Birthday', 'День народження')}: ${tr(lang, b.name)}`} aria-label={`${s('Birthday', 'День народження')}: ${tr(lang, b.name)}`} data-birthday>
                      <span class="absolute inset-0 sm:hidden" aria-hidden="true"></span>
                      <span class="mt-1 block h-1.5 w-1.5 rounded-full bg-[var(--color-gold)] sm:hidden" aria-hidden="true"></span>
                      <span class="mt-1 hidden rounded-md bg-[var(--color-gold-soft)] px-1.5 py-1 text-[12px] font-[560] leading-[1.2] text-[var(--color-lions-deep)] [overflow-wrap:anywhere] sm:block"><span aria-hidden="true">🎂</span> {tr(lang, b.name).split(' ')[0]}</span>
                    </a>
                  ))}
                </div>
              ) : <div />;
            })}
          </div>
          <ul class="mt-4 grid gap-2 sm:hidden">
            {bdOf(key).map((b) => (
              <li><a href={lp(lang, `/members/${b.slug}`)} class="flex items-baseline gap-3 rounded-xl bg-[var(--color-gold-soft)] px-4 py-3 text-[var(--color-lions-deep)]">
                <span class="t-num w-6 shrink-0 text-[17px] font-[700]">{Number(b.date.slice(8))}</span>
                <span class="text-[16px] font-[600]">{s('Birthday', 'День народження')}: {tr(lang, b.name)}</span>
              </a></li>
            ))}
            {list!.map((e) => (
              <li><a href={lp(lang, `/events/${e.slug}`)} class="flex items-baseline gap-3 rounded-xl bg-[var(--bg-alt)] px-4 py-3">
                <span class="t-num w-6 shrink-0 text-[17px] font-[700]">{dayNum(e.start, lang)}</span>
                <span class="text-[16px] font-[600]">{tr(lang, e.title)}</span>
              </a></li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>
</Base>

<script>
  import { upcomingEvents, esc } from '../../../scripts/api';
  import { ct, clang, cfmt } from '../../../scripts/i18n';
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-view]');
    if (!tabs.length) return;
    const show = (view: string) => {
      tabs.forEach((x) => { const on = x.dataset.view === view; x.setAttribute('aria-selected', String(on)); x.classList.toggle('bg-[var(--surface)]', on); x.classList.toggle('shadow-sm', on); });
      document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== view));
    };
    tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.view!); history.replaceState(history.state, '', t.dataset.view === 'cal' ? '#calendar' : location.pathname); }));
    if (location.hash === '#calendar') show('cal');
    const sub = document.querySelector<HTMLDetailsElement>('[data-sub]');
    if (sub) document.addEventListener('click', (e) => { if (sub.open && !sub.contains(e.target as Node)) sub.open = false; });
    // Нові події з адмінки (і закриті для членів клубу) показуємо одразу, до перезбирання сайту
    const box = document.querySelector<HTMLElement>('[data-local-events]');
    if (!box) return;
    const known: string[] = JSON.parse(box.dataset.known || '[]');
    upcomingEvents().then((list) => {
      const fresh = list.filter((e) => !known.includes(e.slug) && new Date(e.starts_at) > new Date());
      const uk = clang() === 'uk';
      const pick = (en: string | null, ukv: string | null) => (uk ? ukv || en : en || ukv) || '';
      box.innerHTML = fresh.length ? `<div class="mb-14"><h2 class="t-h3 mb-4">${ct().addedInAdmin}</h2><ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">${fresh.map((e) => `
        <li class="py-6"><p class="text-[21px] font-[650]">${esc(pick(e.title_en, e.title_uk))}${e.visibility === 'members' ? ` <span class="badge ml-1">${uk ? 'для членів клубу' : 'members only'}</span>` : ''}</p>
        <p class="text-soft">${e.time_unknown ? cfmt(e.starts_at, { weekday: 'long', day: 'numeric', month: 'long' }) : cfmt(e.starts_at, { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}. ${esc(pick(e.location_en, e.location_uk))}</p>
        ${pick(e.description_en, e.description_uk) ? `<p class="mt-1 max-w-[60ch] text-[15px] text-soft">${esc(pick(e.description_en, e.description_uk))}</p>` : ''}</li>`).join('')}</ul></div>` : '';
    }).catch(() => {});
  });
</script>
