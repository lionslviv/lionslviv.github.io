---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Photo from '../../../components/Photo.astro';
import { albums } from '../../../data/live';
import { dateLong } from '../../../lib/format';
import { langPaths, langOf, lp, tr, t, photoCount } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
const [first, ...rest] = albums;
const ft = tr(lang, first.title);
---
<Base title={T.nav.gallery} description={s('Photo albums from events and projects of Lviv International Lions Club.', 'Фотоальбоми подій і проєктів Lviv International Lions Club.')}>
  <PageHead title={T.nav.gallery} lead={s('Albums from events and projects. Club members add photos; editors publish them after review.', 'Альбоми з подій і проєктів. Члени клубу додають фото, редактори публікують після перевірки.')} />
  <section class="wrap pb-24">
    <a href={lp(lang, `/gallery/${first.slug}`)} class="group mb-14 block">
      <div class="grid grid-cols-4 gap-2 overflow-hidden rounded-[var(--radius-card)] md:grid-cols-6">
        <Photo art={first.photos[0]} alt={ft} ratio="1 / 1" class="col-span-2 row-span-2" />
        {first.photos.slice(1, 9).map((p, i) => <Photo art={p} alt={ft} ratio="1 / 1" class={i > 3 ? 'hidden md:block' : ''} />)}
      </div>
      <div class="mt-5 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="t-h2 group-hover:text-[var(--accent)]">{ft}</h2>
        <p class="text-soft">{dateLong(first.date, lang)}, {photoCount(lang, first.photos.length)}</p>
      </div>
    </a>
    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((a) => (
        <a href={lp(lang, `/gallery/${a.slug}`)} class="group space-y-4">
          <div class="overflow-hidden rounded-[var(--radius-card)]"><Photo art={a.photos[0]} alt={tr(lang, a.title)} ratio="4 / 3" class="transition-transform duration-700 group-hover:scale-[1.03]" /></div>
          <div>
            <h2 class="text-[21px] font-[650] tracking-[-0.015em] group-hover:text-[var(--accent)]">{tr(lang, a.title)}</h2>
            <p class="t-small mt-1">{dateLong(a.date, lang)}, {photoCount(lang, a.photos.length)}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
