---
import Base from '../../layouts/Base.astro';
import { langPaths, langOf, lp, tr, t } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
---
<Base title={T.account} noindex>
  <section class="wrap pb-24 pt-[clamp(3rem,7vw,6rem)]" data-account>
    <div data-anon hidden class="space-y-5">
      <h1 class="t-h1">{T.account}</h1>
      <p class="t-lead">{s('Sign in to see your account.', 'Увійдіть, щоб побачити кабінет.')}</p>
      <a href={lp(lang, '/login')} class="btn btn-blue">{T.signIn}</a>
    </div>
    <div data-auth hidden>
      <p class="text-soft" data-role></p>
      <h1 class="t-h1 mt-2" data-name></h1>
      <div class="mt-12 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
        <form class="panel grid gap-5 p-8" data-profile>
          <h2 class="t-h3">{s('My profile', 'Мій профіль')}</h2>
          <div class="field"><label for="p-name">{s('Full name', 'Ім’я та прізвище')}</label><input id="p-name" name="name" class="input" required /></div>
          <div class="field"><label for="p-field">{s('Profession or field', 'Професія або сфера')}</label><input id="p-field" name="field" class="input" /></div>
          <div class="field"><label for="p-bio">{s('About me', 'Коротко про себе')} <span class="text-soft">({s('up to 300 characters', 'до 300 символів')})</span></label><textarea id="p-bio" name="bio" class="textarea" maxlength="300"></textarea></div>
          <div class="field"><label for="p-quote">{s('Why I am a Lion', 'Чому я в Lions')}</label><input id="p-quote" name="quote" class="input" maxlength="140" /></div>
          <label class="check"><input type="checkbox" name="isPublic" /> <span>{s('Show my profile on the website. Only club members see phone and email.', 'Показувати мій профіль на сайті. Телефон і email бачать лише члени клубу.')}</span></label>
          <div class="flex items-center gap-4"><button class="btn btn-blue" type="submit">{s('Save profile', 'Зберегти профіль')}</button><p class="text-[15px]" role="status" data-saved></p></div>
        </form>
        <div class="grid content-start gap-6">
          <div class="panel p-8" data-members-only>
            <h2 class="t-h3">{s('My meetings', 'Мої зустрічі')}</h2>
            <p class="mt-2 text-soft">{s('Members-only club meetings and your RSVPs.', 'Закриті збори клубу і ваші відповіді RSVP.')}</p>
            <a href={lp(lang, '/events')} class="btn btn-quiet btn-sm mt-5">{s('Event schedule', 'Розклад подій')}</a>
          </div>
          <div class="panel p-8" data-members-only>
            <h2 class="t-h3">{s('Add photos', 'Додати фото')}</h2>
            <p class="mt-2 text-soft">{s('Event photos go to editors for moderation. We compress them and strip location data automatically.', 'Фото з події потрапляють редакторам на модерацію. Ми стискаємо їх і прибираємо геолокацію автоматично.')}</p>
            <label class="btn btn-quiet btn-sm mt-5 cursor-pointer">{s('Choose photos', 'Обрати фото')}<input type="file" accept="image/*" multiple class="sr-only" data-upload /></label>
            <p class="t-small mt-3" data-upload-note></p>
          </div>
          <button class="btn btn-ghost w-fit" data-logout>{s('Sign out', 'Вийти')}</button>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  import { getUser, updateUser, signOut, roleName, can } from '../../scripts/store';
  import { ct, cprefix } from '../../scripts/i18n';
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-account]');
    if (!root) return;
    const user = getUser();
    (root.querySelector('[data-anon]') as HTMLElement).hidden = !!user;
    (root.querySelector('[data-auth]') as HTMLElement).hidden = !user;
    if (!user) return;
    root.querySelector('[data-role]')!.textContent = roleName(user.role);
    root.querySelector('[data-name]')!.textContent = user.name;
    root.querySelectorAll<HTMLElement>('[data-members-only]').forEach((el) => (el.hidden = !can.memberArea(user)));
    const f = root.querySelector<HTMLFormElement>('[data-profile]')!;
    (f.elements.namedItem('name') as HTMLInputElement).value = user.name;
    (f.elements.namedItem('field') as HTMLInputElement).value = user.field ?? '';
    (f.elements.namedItem('bio') as HTMLTextAreaElement).value = user.bio ?? '';
    (f.elements.namedItem('quote') as HTMLInputElement).value = user.quote ?? '';
    (f.elements.namedItem('isPublic') as HTMLInputElement).checked = !!user.isPublic;
    f.onsubmit = (e) => {
      e.preventDefault();
      const d = new FormData(f);
      updateUser({ name: String(d.get('name')), field: String(d.get('field')), bio: String(d.get('bio')), quote: String(d.get('quote')), isPublic: d.get('isPublic') === 'on' });
      root.querySelector('[data-name]')!.textContent = String(d.get('name'));
      root.querySelector('[data-saved]')!.textContent = ct().profileSaved;
    };
    const up = root.querySelector<HTMLInputElement>('[data-upload]');
    if (up) up.onchange = () => { root.querySelector('[data-upload-note]')!.textContent = ct().uploadSent(up.files?.length ?? 0); };
    root.querySelector<HTMLButtonElement>('[data-logout]')!.onclick = () => { signOut(); location.href = `${cprefix()}/`; };
  });
</script>
