---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { projects } from '../../../data/content';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
---
<Base title={T.nav.projects} description={s('Service projects of Lviv International Lions Club.', 'Проєкти служіння Lviv International Lions Club.')}>
  <PageHead title={T.nav.projects} lead={s('The club focuses on healthcare and humanitarian aid.', 'Клуб зосереджується на охороні здоров’я та гуманітарній допомозі.')} />
  <section class="wrap pb-24">
    {projects.length === 0 ? (
      <div class="panel max-w-[46rem] p-6 sm:p-10">
        <h2 class="t-h3">{s('Project information is coming soon', 'Інформація про проєкти незабаром')}</h2>
        <p class="mt-3 text-[17px] leading-[1.6] text-soft">{s('We will add information about the club’s projects after the meeting on 3 December.', 'Інформацію про проєкти клубу додамо після зустрічі 3 грудня.')}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={lp(lang, '/events/tretia-zustrich')} class="btn btn-blue btn-sm">{s('About the 3 December meeting', 'Про зустріч 3 грудня')}</a>
          <a href={lp(lang, '/support')} class="btn btn-quiet btn-sm">{T.support}</a>
        </div>
      </div>
    ) : (
      <ul class="grid gap-8 md:grid-cols-2">
        {projects.map((p) => (
          <li><a href={lp(lang, `/projects/${p.slug}`)} class="group block space-y-2">
            <h2 class="t-h3 group-hover:text-[var(--accent)]">{tr(lang, p.title)}</h2>
            <p class="text-soft">{tr(lang, p.excerpt)}</p>
          </a></li>
        ))}
      </ul>
    )}
  </section>
</Base>
