---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Photo from '../../../components/Photo.astro';
import { projects } from '../../../data/content';
import { causeLabel } from '../../../data/site';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
const active = projects.filter((p) => p.status === 'active');
const done = projects.filter((p) => p.status === 'done');
const v = (x: string) => (lang === 'uk' ? x.replace(',', ' ') : x);
---
<Base title={T.nav.projects} description={s('Service projects of Lviv International Lions Club: vision for children, light for communities, youth, environment.', 'Проєкти служіння Lviv International Lions Club: зір для дітей, світло для громад, молодь, довкілля.')}>
  <PageHead title={T.nav.projects} lead={s('Every project has a goal in numbers, a responsible person and a public report. The club focuses on healthcare and humanitarian aid.', 'Кожен проєкт має мету в цифрах, відповідальну людину і публічний звіт. Фокус клубу: охорона здоров’я та гуманітарна допомога.')}>
    <p class="panel mt-6 max-w-[60ch] p-5 text-[15px]">{s('The projects below show how this section will look. They are examples: the club is still shaping its first projects.', 'Проєкти нижче показують, як виглядатиме розділ. Це приклади, клуб ще формує свої перші проєкти.')}</p>
  </PageHead>
  <section class="wrap grid gap-20 pb-24">
    {active.map((p, i) => (
      <a href={lp(lang, `/projects/${p.slug}`)} class={`group grid items-center gap-8 md:grid-cols-2 md:gap-14 ${i % 2 ? 'md:[&>*:first-child]:order-2' : ''}`}>
        <div class="overflow-hidden rounded-[var(--radius-card)]" transition:name={`cover-${p.slug}`}>
          <Photo art={p.cover} alt={tr(lang, p.title)} ratio="4 / 3" class="transition-transform duration-700 group-hover:scale-[1.03]" />
        </div>
        <div class="space-y-4">
          <div class="flex flex-wrap gap-2">{p.tags.map((g) => <span class="badge badge-blue">{causeLabel(g, lang)}</span>)}{p.demo && <span class="badge badge-gold">{T.demo}</span>}</div>
          <h2 class="t-h2 group-hover:text-[var(--accent)]" transition:name={`title-${p.slug}`}>{tr(lang, p.title)}</h2>
          <p class="t-lead">{tr(lang, p.excerpt)}</p>
          {p.stats && (
            <p class="flex flex-wrap gap-x-8 gap-y-2 pt-2">
              {p.stats.map((m) => <span><span class="t-num text-[26px] font-[740] tracking-[-0.03em]">{v(m.value)}</span> <span class="text-soft">{tr(lang, m.label)}</span></span>)}
            </p>
          )}
        </div>
      </a>
    ))}
    {done.length > 0 && (
      <div>
        <h2 class="t-h3 mb-6">{s('Completed', 'Завершені')}</h2>
        <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {done.map((p) => (
            <li><a href={lp(lang, `/projects/${p.slug}`)} class="group flex flex-col gap-1 py-6 md:flex-row md:items-baseline md:justify-between">
              <span class="text-[21px] font-[640] group-hover:text-[var(--accent)]">{tr(lang, p.title)}</span>
              <span class="text-soft">{p.stats?.[0] ? `${v(p.stats[0].value)} ${tr(lang, p.stats[0].label)}` : ''}</span>
            </a></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
