---
// Бренд і матеріали: правила з офіційних брендбуків Lions International
// і завантаження для членів клубу, партнерів і медіа.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { brandColors, brandDocs, nameRules, emblemDonts, photoRules, brandContact, trademarkContact } from '../../data/brand';
import { u } from '../../lib/url';
import BrandAsset from '../../components/BrandAsset.astro';
import { brandAssets, assetPath } from '../../data/brand-assets';
import { langPaths, langOf, lp, tr, t } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);

const exists = (p: string) => !!p && fs.existsSync(path.join(process.cwd(), 'public', p));
const docs = brandDocs.map((d) => ({ ...d, hasLocal: exists(d.local), size: exists(d.local) ? Math.round(fs.statSync(path.join(process.cwd(), 'public', d.local)).size / 1024 / 1024 * 10) / 10 : 0 }));
const primary = brandColors.filter((c) => c.role === 'primary');
const secondary = brandColors.filter((c) => c.role === 'secondary');
const light = (hex: string) => ['#EBB700', '#B3B2B1'].includes(hex);
const assets = brandAssets.map((a) => ({ ...a, ok: !!assetPath(a.key) }));
const okCount = assets.filter((a) => a.ok).length;
---
<Base title={T.nav.brand} description={s('Lions International brand rules for Lviv International Lions Club: name, emblem, colours, fonts, photography. Official brand books and club materials.', 'Правила бренду Lions International для Lviv International Lions Club: назва, емблема, кольори, шрифти, фото. Офіційні брендбуки і матеріали клубу.')}>
  <PageHead title={T.nav.brand} lead={s('How to write the name and use the emblem, colours and photos correctly. For club members, partners and media.', 'Як правильно писати назву, використовувати емблему, кольори і фото. Для членів клубу, партнерів і медіа.')} />

  <section class="wrap pb-16">
    <h2 class="t-h3">{s('Official documents', 'Офіційні документи')}</h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {docs.map((d) => (
        <li class="panel flex flex-col p-7">
          <p class="t-small">{tr(lang, d.version)}</p>
          <h3 class="mt-1 text-[21px] font-[650] leading-tight tracking-[-0.015em]">{tr(lang, d.title)}</h3>
          <p class="mt-3 flex-1 text-soft">{tr(lang, d.about)}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {d.hasLocal && <a class="btn btn-blue btn-sm" href={u(d.local)} download>{s('Download PDF', 'Завантажити PDF')}{d.size ? `, ${d.size} ${s('MB', 'МБ')}` : ''}</a>}
            <a class={`btn btn-sm ${d.hasLocal ? 'btn-quiet' : 'btn-blue'}`} href={d.official} target="_blank" rel="noopener">{d.official.includes('.pdf') ? s('Open PDF on the Lions site', 'Відкрити PDF на сайті Lions') : s('On the Lions site', 'На сайті Lions')}</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="t-small mt-5 max-w-[70ch]">
      {s('Lions members are automatically entitled to use registered Lions trademarks in club and district materials, including websites and social media (Brand Guidelines V4.0, p. 14). Other uses require written permission:', 'Члени Lions автоматично мають право використовувати зареєстровані торговельні марки Lions у матеріалах клубу та дистрикту, зокрема на сайтах і в соцмережах (Brand Guidelines V4.0, с. 14). Для інших цілей потрібен письмовий дозвіл:')} {trademarkContact}.
    </p>
  </section>

  <section class="section-tight bg-alt">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="space-y-4">
        <h2 class="t-h2">{s('How to write the name', 'Як писати назву')}</h2>
        <p class="t-lead">{s('We are the second Lions club in Lviv, so the name is always written in full: Lviv International Lions Club.', 'Наш клуб другий Lions club у Львові, тому назва завжди повна: Lviv International Lions Club.')}</p>
        <p class="text-soft">{s('The official record in the Lions International registry is agreed with Lions International under the club naming rules (Board Policy Manual, chapter 10).', 'Офіційний запис у реєстрі Lions International погоджуємо з Lions International за правилами назв клубів (Board Policy Manual, розділ 10).')}</p>
      </div>
      <dl class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
        {nameRules.map(([k, v]) => (
          <div class="grid gap-1 py-4 sm:grid-cols-[1fr_1.3fr] sm:gap-6">
            <dt class="text-soft">{tr(lang, k)}</dt>
            <dd class="font-[600]">{tr(lang, v)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="space-y-4">
        <h2 class="t-h2">{s('Emblem', 'Емблема')}</h2>
        <p class="t-lead">{s('The emblem and signatures are never redrawn. Official files from lionsclubs.org only.', 'Емблему і підписи ніколи не перемальовують. Лише офіційні файли з lionsclubs.org.')}</p>
        <ul class="grid gap-2 text-[17px]">
          <li><span class="font-[620]">{s('Clear space:', 'Вільне поле:')}</span> {s('at least the height of the “L” in the centre of the emblem on all sides.', 'не менше висоти літери «L» у центрі емблеми з усіх боків.')}</li>
          <li><span class="font-[620]">{s('Print size:', 'Розмір у друці:')}</span> {s('ideally 1.43 cm, at least 0.95 cm emblem height.', 'бажано 1,43 см, мінімум 0,95 см заввишки емблеми.')}</li>
          <li><span class="font-[620]">{s('Colours:', 'Кольори:')}</span> {s('Blue 287, two colour 287 + 7406, full colour or black and white.', 'Blue 287, двоколірна 287 + 7406, повнокольорова або чорно-біла.')}</li>
        </ul>
        <a href="https://www.lionsclubs.org/en/logos" target="_blank" rel="noopener" class="link inline-block">{s('Official emblem files', 'Офіційні файли емблеми')}</a>
      </div>
      <div>
        <h3 class="text-[19px] font-[650]">{s('What not to do', 'Чого не робити')}</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {emblemDonts.map((x) => (
            <li class="flex gap-3 rounded-2xl border border-[var(--line)] p-4">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-[var(--color-coral)]" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
              <span>{tr(lang, x)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight bg-alt">
    <div class="wrap">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="t-h2">{s('Official files on the site', 'Офіційні файли на сайті')}</h2>
        <p class="text-soft">{s(`${okCount} of ${assets.length} added`, `${okCount} з ${assets.length} додано`)}</p>
      </div>
      <p class="t-lead mt-3 max-w-[60ch]">{s('The emblem, Lions International signatures and service icons from lionsclubs.org. Originals (PNG, CMYK JPG, EPS for print) are stored in the project. We do not distribute them publicly: Lions members can download official files on the organisation’s website.', 'Емблема, підписи Lions International та іконки напрямів служіння з lionsclubs.org. Оригінали (PNG, JPG CMYK, EPS для друку) зберігаються в проєкті. Публічно ми їх не роздаємо: завантажувати офіційні файли можуть члени Lions на сайті організації.')}</p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {assets.map((a) => (
          <li class="flex flex-col rounded-[var(--radius-card)] bg-[var(--surface)] p-5">
            <div class={`grid h-32 place-items-center rounded-2xl ${a.dark ? 'bg-[var(--color-lions-deep)]' : 'bg-[var(--bg-alt)]'}`}>
              <BrandAsset name={a.key} alt={tr(lang, a.title)} height={a.key === 'signature' || a.key === 'signature-white' ? 34 : a.key.startsWith('signature') ? 72 : 64} clearSpace showMissing />
            </div>
            <p class="mt-4 font-[640] leading-tight">{tr(lang, a.title)}</p>
            <p class="t-small mt-1">{a.source}</p>
            {a.file && <p class="t-small mt-1 break-all">{s('Original', 'Оригінал')}: docs/brand/logos/{a.file}</p>}
            <p class="t-small mt-auto pt-3">{a.ok ? <span class="text-[var(--color-green)]">{s('Added.', 'Додано.')}</span> : <span>{s('Not yet.', 'Ще немає.')}</span>} {tr(lang, a.where)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2 class="t-h2">{s('Colours', 'Кольори')}</h2>
      <p class="t-lead mt-3 max-w-[52ch]">{s('Primary palette: blue, yellow and purple. Secondary colours are for accents only.', 'Основна палітра: синій, жовтий і фіолетовий. Вторинні кольори лише для акцентів.')}</p>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {primary.map((c) => (
          <li class="overflow-hidden rounded-[var(--radius-card)] bg-[var(--surface)]">
            <div class="flex h-40 items-end p-5" style={`background:${c.hex}`}>
              <p class={`text-[24px] font-[720] tracking-[-0.02em] ${light(c.hex) ? 'text-[var(--color-lions-deep)]' : 'text-white'}`}>{c.name}</p>
            </div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 p-5 text-[15px]">
              <dt class="text-soft">HEX</dt><dd class="t-num font-[600]">{c.hex}</dd>
              <dt class="text-soft">Pantone</dt><dd>{c.pantone}</dd>
              <dt class="text-soft">CMYK</dt><dd class="t-num">{c.cmyk}</dd>
              <dt class="text-soft">RGB</dt><dd class="t-num">{c.rgb}</dd>
            </dl>
            <p class="t-small px-5 pb-5">{tr(lang, c.use)}</p>
          </li>
        ))}
      </ul>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {secondary.map((c) => (
          <li class="overflow-hidden rounded-2xl bg-[var(--surface)]">
            <div class="h-20" style={`background:${c.hex}`}></div>
            <div class="p-4 text-[14px]">
              <p class="font-[640]">{c.name}</p>
              <p class="t-num text-soft">{c.hex}</p>
              <p class="text-soft">{c.pantone}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight bg-alt">
    <div class="wrap grid gap-12 md:grid-cols-2">
      <div class="space-y-4">
        <h2 class="t-h2">{s('Typefaces', 'Шрифти')}</h2>
        <p class="text-[19px] leading-[1.6]"><span class="font-[650]">Helvetica Neue</span> {s('is the main Lions typeface for print and layouts. Bold headings, medium subheadings, light body text.', 'основний шрифт Lions для друку і макетів. Заголовки жирні, підзаголовки середні, текст легкий.')}</p>
        <p class="text-[19px] leading-[1.6]"><span class="font-[650]">Roboto</span> {s('is the digital typeface for the web. The club site uses Roboto Flex, the variable version of Roboto with Cyrillic.', 'цифровий шрифт для вебу. Сайт клубу використовує Roboto Flex, змінну версію Roboto з кирилицею.')}</p>
        <p class="text-soft">{s('For Word documents without these fonts: Helvetica or Arial.', 'Для документів у Word, якщо цих шрифтів немає: Helvetica або Arial.')}</p>
      </div>
      <div class="panel min-w-0 p-8">
        <p class="text-[clamp(2.1rem,9vw,3.5rem)] font-[760] leading-none tracking-[-0.035em]" style="font-stretch:120%">Lviv International</p>
        <p class="mt-4 text-[28px] font-[600] tracking-[-0.015em]">{s('Serving the city of the lion', 'Служимо місту лева')}</p>
        <p class="mt-3 text-[17px] text-soft">{s('Roboto Flex: heading 760, subheading 600, body 400.', 'Roboto Flex: заголовок 760, підзаголовок 600, текст 400.')}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2 class="t-h2">{s('Photography', 'Фото')}</h2>
      <p class="t-lead mt-3 max-w-[56ch]">{s('We show Lions in action and the people we help. Warm, natural, unstaged.', 'Показуємо Lions у дії і людей, яким допомагаємо. Тепло, природно, без постановки.')}</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-[var(--radius-card)] bg-[var(--surface)] p-7">
          <h3 class="text-[19px] font-[650] text-[var(--color-green)]">{s('Yes', 'Так')}</h3>
          <ul class="mt-4 grid gap-2">{photoRules.do.map((x) => <li>{tr(lang, x)}</li>)}</ul>
        </div>
        <div class="rounded-[var(--radius-card)] bg-[var(--surface)] p-7">
          <h3 class="text-[19px] font-[650] text-[var(--color-coral)]">{s('No', 'Ні')}</h3>
          <ul class="mt-4 grid gap-2">{photoRules.dont.map((x) => <li>{tr(lang, x)}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-alt">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1.2fr]">
      <div class="space-y-4">
        <h2 class="t-h2">{s('Club materials', 'Матеріали клубу')}</h2>
        <p class="t-lead">{s('For partners and media writing about the club.', 'Для партнерів і медіа, які пишуть про клуб.')}</p>
      </div>
      <ul class="grid gap-4">
        <li class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-[var(--line)] p-5">
          <div><p class="font-[640]">{s('Social media cover', 'Обкладинка для соцмереж')}</p><p class="t-small">PNG, 1200×630</p></div>
          <a href={u('/og.png')} download class="btn btn-quiet btn-sm">{s('Download', 'Завантажити')}</a>
        </li>
        <li class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-[var(--line)] p-5">
          <div><p class="font-[640]">{s('About the club in brief', 'Коротко про клуб')}</p><p class="t-small">{s('Text for announcements and press releases', 'Текст для анонсів і пресрелізів')}</p></div>
          <button class="btn btn-quiet btn-sm" data-copy-boiler>{s('Copy text', 'Скопіювати текст')}</button>
        </li>
        <li class="rounded-2xl border border-[var(--line)] p-5">
          <p class="text-[15px] leading-[1.6]" data-boiler>{s('Lviv International Lions Club is an English-speaking club of Lions Clubs International in Lviv, Ukraine, focusing on healthcare and humanitarian service. Lions Clubs International is the world’s largest service club organisation, with more than 1.4 million members in over 48,000 clubs in more than 200 countries and geographic areas. It was founded in 1917.', 'Lviv International Lions Club це англомовний клуб Lions Clubs International у Львові, що зосереджується на охороні здоров’я та гуманітарній допомозі. Lions Clubs International є найбільшою у світі організацією сервісних клубів: понад 1,4 мільйона членів у більш ніж 48 000 клубах у понад 200 країнах і регіонах. Організацію засновано 1917 року.')}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="py-16">
    <div class="wrap">
      <p class="panel p-6 text-[15px]">{s('Questions about the Lions brand', 'Питання щодо бренду Lions')}: <a class="link" href={`mailto:${brandContact}`}>{brandContact}</a>. {s('Questions about club materials', 'Питання щодо матеріалів клубу')}: <a class="link" href={lp(lang, '/contacts')}>{s('club contacts', 'контакти клубу')}</a>.</p>
    </div>
  </section>
</Base>
<script>
  import { ct } from '../../scripts/i18n';
  document.addEventListener('astro:page-load', () => {
    const b = document.querySelector<HTMLButtonElement>('[data-copy-boiler]');
    if (!b) return;
    b.onclick = async () => {
      try { await navigator.clipboard.writeText(document.querySelector('[data-boiler]')!.textContent!.trim()); b.textContent = ct().copied; }
      catch { b.textContent = ct().copyFail; }
      setTimeout(() => (b.textContent = ct().copyText), 2000);
    };
  });
</script>
