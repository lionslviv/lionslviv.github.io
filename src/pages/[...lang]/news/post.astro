---
// Перегляд поста, створеного в демо-адмінці (дані з localStorage).
// У продакшні це звичайна сторінка /news/[slug] з даними з Supabase.
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
---
<Base title={s('News', 'Новина')} noindex>
  <article class="wrap-narrow pb-16 pt-[clamp(3rem,7vw,6rem)]" data-local-post>
    <a href={lp(lang, '/news')} class="link text-[15px]">{T.allNews}</a>
    <img data-cover alt="" class="mt-8 hidden aspect-[21/9] w-full rounded-[var(--radius-card)] object-cover" />
    <p class="t-small mt-6" data-date></p>
    <h1 class="t-h1 mt-3" data-title>{s('Loading…', 'Завантаження…')}</h1>
    <p class="t-lead mt-5" data-excerpt></p>
    <div class="prose-lions mt-10" data-body></div>
  </article>
  <Comments target="local-post" />
</Base>
<script>
  import { postBySlug, paragraphs, mediaUrl } from '../../../scripts/api';
  import { ct, cfmt, clang, cprefix } from '../../../scripts/i18n';
  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-local-post]');
    if (!root) return;
    const slug = new URLSearchParams(location.search).get('slug') || '';
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const p = slug ? await postBySlug(slug) : null;
    if (!p) { q('[data-title]').textContent = ct().notFound; q('[data-excerpt]').textContent = ct().notFoundText; return; }
    const uk = clang() === 'uk';
    const pick = (en: string | null, ukv: string | null) => (uk ? ukv || en : en || ukv) || '';
    const title = pick(p.title_en, p.title_uk);
    document.title = `${title} | Lviv International Lions Club`;
    if (p.cover_url) { const img = q('[data-cover]') as HTMLImageElement; const u = p.cover_url; img.src = /^https?:/.test(u) ? u : u.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${u}` : mediaUrl(u); img.classList.remove('hidden'); }
    q('[data-date]').textContent = p.published_at ? cfmt(p.published_at) : '';
    q('[data-title]').textContent = title;
    q('[data-excerpt]').textContent = pick(p.excerpt_en, p.excerpt_uk);
    q('[data-body]').innerHTML = paragraphs(pick(p.body_en, p.body_uk));
    // Якщо сторінка вже зібрана статично, ведемо на неї (там коментарі й гарна адреса)
    const c = document.querySelector<HTMLElement>('[data-comments]');
    if (c) { c.setAttribute('data-comments', p.slug); window.dispatchEvent(new CustomEvent('llp:change')); }
    void cprefix;
  });
</script>
