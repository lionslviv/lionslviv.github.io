---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Photo from '../../../components/Photo.astro';
import { news } from '../../../data/live';
import { dateLong } from '../../../lib/format';
import { langPaths, langOf, lp, tr, t } from '../../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
const list = [...news].sort((a, b) => b.date.localeCompare(a.date));
---
<Base title={T.nav.news} description={s('News from Lviv International Lions Club: project reports, event announcements and stories of the people we work with.', 'Новини Lviv International Lions Club: звіти про проєкти, анонси подій та історії людей, з якими ми працюємо.')}>
  <PageHead title={T.nav.news} lead={s('Project reports, event announcements and stories of the people we work alongside.', 'Звіти про проєкти, анонси подій та історії людей, поруч з якими ми працюємо.')} />
  <section class="wrap pb-24">
    <!-- Новини, опубліковані після останньої збірки, підтягуються сюди з Supabase -->
    <ul class="grid gap-x-10 gap-y-14 md:grid-cols-2" data-local-posts data-known={JSON.stringify(list.map((n) => n.slug))} hidden></ul>
    <ul class="grid gap-x-10 gap-y-14 md:grid-cols-2">
      {list.map((n, i) => (
        <li class={i === 0 ? 'md:col-span-2' : ''}>
          <a href={lp(lang, `/news/${n.slug}`)} class={`group grid gap-6 ${i === 0 ? 'md:grid-cols-[1.4fr_1fr] md:items-center md:gap-12' : ''}`}>
            <div class="overflow-hidden rounded-[var(--radius-card)]" transition:name={`cover-${n.slug}`}>
              <Photo art={n.cover} alt={tr(lang, n.title)} ratio={i === 0 ? '16 / 10' : '3 / 2'} class="transition-transform duration-700 group-hover:scale-[1.03]" />
            </div>
            <div class="space-y-3">
              <p class="flex flex-wrap items-center gap-2"><time class="t-small" datetime={n.date}>{dateLong(n.date, lang)}</time>{n.demo && <span class="badge badge-gold">{T.demo}</span>}</p>
              <h2 class={`${i === 0 ? 't-h2' : 't-h3'} group-hover:text-[var(--accent)]`} transition:name={`title-${n.slug}`}>{tr(lang, n.title)}</h2>
              <p class="text-soft">{tr(lang, n.excerpt)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { publishedPosts, esc, mediaUrl } from '../../../scripts/api';
  import { ct, cprefix, cfmt, clang } from '../../../scripts/i18n';
  document.addEventListener('astro:page-load', async () => {
    const ul = document.querySelector<HTMLElement>('[data-local-posts]');
    if (!ul) return;
    const known: string[] = JSON.parse(ul.dataset.known || '[]');
    const fresh = (await publishedPosts()).filter((p) => !known.includes(p.slug));
    ul.hidden = fresh.length === 0;
    ul.classList.toggle('mb-14', fresh.length > 0);
    const uk = clang() === 'uk';
    const img = (u: string | null) => (!u ? '' : /^https?:/.test(u) ? u : u.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${u}` : mediaUrl(u));
    ul.innerHTML = fresh.map((p) => `
      <li><a href="${cprefix()}/news/post/?slug=${encodeURIComponent(p.slug)}" class="group grid gap-5">
        ${p.cover_url ? `<div class="overflow-hidden rounded-[var(--radius-card)]"><img src="${esc(img(p.cover_url))}" alt="" loading="lazy" class="aspect-[3/2] w-full object-cover" /></div>` : ''}
        <div class="space-y-3">
          <p class="flex flex-wrap items-center gap-2"><span class="t-small">${p.published_at ? cfmt(p.published_at) : ''}</span><span class="badge badge-gold">${ct().fromAdmin}</span></p>
          <h2 class="t-h3 group-hover:text-[var(--accent)]">${esc((uk ? p.title_uk || p.title_en : p.title_en || p.title_uk) || '')}</h2>
          <p class="text-soft">${esc((uk ? p.excerpt_uk || p.excerpt_en : p.excerpt_en || p.excerpt_uk) || '')}</p>
        </div>
      </a></li>`).join('');
  });
</script>
