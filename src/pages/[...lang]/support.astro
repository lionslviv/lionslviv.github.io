---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { club } from '../../data/site';
import { u } from '../../lib/url';
import { langPaths, langOf, lp, t } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const T = t(lang);
const s = (en: string, uk: string) => (lang === 'uk' ? uk : en);
const d = club.donate;
---
<Base title={T.support} description={s('Support the humanitarian projects of Lviv International Lions Club via a Monobank jar.', 'Підтримайте гуманітарні проєкти Lviv International Lions Club через банку Monobank.')}>
  <PageHead title={s('Support the club', 'Підтримати клуб')} lead={s('Your donation goes to the club’s humanitarian projects. The fastest way is our Monobank jar: by card, Apple Pay or Google Pay.', 'Ваш внесок іде на гуманітарні проєкти клубу. Найшвидше через нашу банку Monobank: карткою, Apple Pay або Google Pay.')} tone="blue" />

  <section class="section-tight">
    <div class="wrap grid gap-6 lg:grid-cols-[1.25fr_1fr] lg:gap-10">
      <div class="panel p-6 sm:p-8 md:p-10">
        <p class="t-small">Monobank</p>
        <h2 class="t-h3 mt-1">{d.jarName}</h2>
        <a href={d.jarUrl} target="_blank" rel="noopener" class="btn btn-gold mt-6 w-full sm:w-auto">{s('Donate via Monobank jar', 'Підтримати через Monobank')}</a>

        <dl class="mt-8 grid gap-6 text-[17px]">
          <div>
            <dt class="t-small">{s('Jar card number', 'Номер картки банки')}</dt>
            <dd class="mt-1 flex flex-wrap items-center gap-3">
              <span class="t-num text-[22px] font-[650] tracking-[0.04em] sm:text-[24px]" data-card>{d.card}</span>
              <button type="button" class="btn btn-quiet btn-sm" data-copy>{s('Copy', 'Скопіювати')}</button>
            </dd>
            <dd class="t-small mt-2">{s('Transfer from any Ukrainian bank card or app.', 'Переказ з картки або застосунку будь-якого українського банку.')}</dd>
          </div>
          <div>
            <dt class="t-small">{s('Jar link', 'Посилання на банку')}</dt>
            <dd class="mt-1 break-all"><a class="link" href={d.jarUrl} target="_blank" rel="noopener">{d.jarUrl.replace('https://', '')}</a></dd>
          </div>
        </dl>
      </div>

      <div class="panel flex flex-col items-center p-6 text-center sm:p-8">
        <img src={u(d.qr)} alt={s('QR code for the Monobank jar', 'QR-код банки Monobank')} width="240" height="240" class="h-[200px] w-[200px] rounded-2xl bg-white p-3 sm:h-[240px] sm:w-[240px]" />
        <p class="mt-5 max-w-[28ch] text-[17px] font-[600]">{s('Scan with your phone camera', 'Скануйте камерою телефона')}</p>
        <p class="t-small mt-1 max-w-[32ch]">{s('The code opens the same Monobank jar.', 'Код відкриває ту саму банку Monobank.')}</p>
      </div>
    </div>
  </section>

  <section class="section-tight bg-alt">
    <div class="wrap grid gap-10 md:grid-cols-3">
      <div><h3 class="t-h3">{s('Transparency', 'Прозорість')}</h3><p class="mt-3 text-soft">{s('We will report in the News section on how donations are used.', 'Про те, на що витрачено внески, розповідатимемо в розділі «Новини».')}</p></div>
      <div><h3 class="t-h3">{s('Partnership for business', 'Партнерство для бізнесу')}</h3><p class="mt-3 text-soft">{s('Joint projects, team volunteering, corporate charity evenings.', 'Спільні проєкти, волонтерство команди, корпоративні благодійні вечори.')} <a class="link" href={lp(lang, '/contacts')}>{s('Write to us', 'Напишіть нам')}</a>.</p></div>
      <div><h3 class="t-h3">{s('Through Lions International', 'Через Lions International')}</h3><p class="mt-3 text-soft">{s('International donors can support Ukraine through LCIF at lionsclubs.org.', 'Міжнародні донори можуть підтримати Україну через фонд LCIF на lionsclubs.org.')}</p></div>
    </div>
  </section>
</Base>
<script>
  import { ct } from '../../scripts/i18n';
  document.addEventListener('astro:page-load', () => {
    const b = document.querySelector<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    b.onclick = async () => {
      const v = document.querySelector('[data-card]')!.textContent!.replace(/\s/g, '');
      try { await navigator.clipboard.writeText(v); b.textContent = ct().copied; } catch { b.textContent = ct().copyFail; }
      setTimeout(() => (b.textContent = ct().copy), 2000);
    };
  });
</script>
