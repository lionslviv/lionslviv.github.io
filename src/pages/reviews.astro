---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { reviews, kindLabel } from '../data/content';
import { dateLong } from '../lib/format';
---
<Base title="Відгуки" description="Відгуки партнерів, волонтерів і отримувачів допомоги про Lions Club Leopolis.">
  <PageHead title="Відгуки про клуб" lead="Публікуємо лише справжні відгуки, зі згодою автора і після модерації. Критику отримує правління напряму." />
  <section class="wrap grid gap-14 pb-16 lg:grid-cols-[1.5fr_1fr]">
    <div>
      <ul class="grid gap-6" data-reviews>
        {reviews.map((r) => (
          <li class="panel p-7 md:p-8">
            <p class="text-[21px] leading-[1.45]">{r.text}</p>
            <p class="mt-5 text-[15px]"><span class="font-[640]">{r.author}</span> <span class="text-soft">{kindLabel[r.kind]}, {dateLong(r.date)}</span> <span class="badge badge-gold ml-1">демо</span></p>
          </li>
        ))}
      </ul>
    </div>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="t-h3">Залишити відгук</h2>
      <form class="mt-6 grid gap-5" data-review-form novalidate>
        <div class="field"><label for="rv-name">Ім’я або організація</label><input id="rv-name" name="author" class="input" required /></div>
        <div class="field"><label for="rv-kind">Хто ви для клубу</label>
          <select id="rv-kind" name="kind" class="select">
            <option value="partner">Партнер</option><option value="beneficiary">Отримувач допомоги</option><option value="volunteer">Волонтер</option><option value="guest" selected>Гість</option>
          </select></div>
        <div class="field"><label for="rv-text">Відгук</label><textarea id="rv-text" name="text" class="textarea" maxlength="1200" required></textarea></div>
        <div class="field"><label for="rv-email">Email (не публікується)</label><input id="rv-email" name="email" type="email" class="input" /></div>
        <label class="check"><input type="checkbox" name="consent" /> <span>Погоджуюся на публікацію відгуку з моїм ім’ям.</span></label>
        <button class="btn btn-blue w-fit" type="submit">Надіслати відгук</button>
        <p class="text-[15px]" role="status" data-status></p>
      </form>
    </aside>
  </section>
</Base>
<script>
  import { reviews, addReview, esc, fmtDate } from '../scripts/store';
  const kinds: Record<string, string> = { partner: 'Партнер', beneficiary: 'Отримувач допомоги', volunteer: 'Волонтер', guest: 'Гість' };
  function paint() {
    const ul = document.querySelector<HTMLElement>('[data-reviews]');
    if (!ul) return;
    ul.querySelectorAll('[data-local]').forEach((n) => n.remove());
    reviews().filter((r) => r.status === 'approved').forEach((r) => {
      ul.insertAdjacentHTML('afterbegin', `<li class="panel p-7 md:p-8" data-local><p class="text-[21px] leading-[1.45]">${esc(r.text)}</p>
        <p class="mt-5 text-[15px]"><span class="font-[640]">${esc(r.author)}</span> <span class="text-soft">${kinds[r.kind] ?? ''}, ${fmtDate(r.at)}</span></p></li>`);
    });
  }
  document.addEventListener('astro:page-load', () => {
    paint();
    const f = document.querySelector<HTMLFormElement>('[data-review-form]');
    if (!f || f.dataset.bound) return; f.dataset.bound = '1';
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const st = f.querySelector<HTMLElement>('[data-status]')!;
      if (!f.checkValidity()) { st.textContent = 'Вкажіть ім’я і текст відгуку.'; st.className = 'text-[15px] text-[#b42318]'; f.reportValidity(); return; }
      const d = new FormData(f);
      addReview({ author: String(d.get('author')), kind: String(d.get('kind')), text: String(d.get('text')), email: String(d.get('email') || ''), consent: d.get('consent') === 'on' });
      f.reset();
      st.className = 'text-[15px] text-[#067647]';
      st.textContent = 'Дякуємо! Відгук з’явиться після модерації.';
    });
  });
</script>
