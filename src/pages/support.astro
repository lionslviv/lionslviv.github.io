---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { club } from '../data/site';
import { projects } from '../data/content';
import { u } from '../lib/url';
const active = projects.filter((p) => p.status === 'active');
---
<Base title="Підтримати" description="Як підтримати проєкти Lviv International Lions Club: реквізити, звітність, партнерство.">
  <PageHead title="Підтримати клуб" lead="Усі кошти йдуть на проєкти служіння. Адміністративні витрати клубу покривають членські внески." tone="blue" />
  <section class="section-tight">
    <div class="wrap grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="panel p-8 md:p-10">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="t-h3">Реквізити для переказу</h2>
          <span class="badge badge-gold">демо</span>
        </div>
        <dl class="mt-8 grid gap-5 text-[17px]">
          <div><dt class="t-small">Отримувач</dt><dd class="font-[600]">{club.bank.recipient}</dd></div>
          <div><dt class="t-small">IBAN</dt><dd class="flex flex-wrap items-center gap-3"><span class="t-num font-[600] tracking-[0.02em]" data-iban>{club.bank.iban}</span><button class="btn btn-quiet btn-sm" data-copy>Скопіювати</button></dd></div>
          <div><dt class="t-small">ЄДРПОУ</dt><dd class="t-num font-[600]">{club.bank.edrpou}</dd></div>
          <div><dt class="t-small">Призначення платежу</dt><dd class="font-[600]">{club.bank.purpose}</dd></div>
        </dl>
        <p class="t-small mt-8">Онлайн-оплату карткою підключимо після реєстрації ГО (Monobank-банка або LiqPay). Реквізити вище умовні.</p>
      </div>
      <div class="space-y-6">
        <h2 class="t-h3">На що можна задонатити</h2>
        <ul class="grid gap-4">
          {active.map((p) => (
            <li><a href={u(`/projects/${p.slug}`)} class="group block rounded-[18px] border border-[var(--line)] p-5 hover:border-[var(--color-lions-sky)]">
              <p class="text-[19px] font-[640] group-hover:text-[var(--accent)]">{p.title}</p>
              <p class="mt-1 text-soft">{p.excerpt}</p>
            </a></li>
          ))}
        </ul>
        <p class="text-soft">Вкажіть назву проєкту в призначенні платежу, і ми спрямуємо кошти саме туди.</p>
      </div>
    </div>
  </section>
  <section class="section-tight bg-alt">
    <div class="wrap grid gap-10 md:grid-cols-3">
      <div><h3 class="t-h3">Звітність</h3><p class="mt-3 text-soft">Щокварталу публікуємо, скільки зібрали і на що витратили, з чеками та актами передачі.</p></div>
      <div><h3 class="t-h3">Партнерство для бізнесу</h3><p class="mt-3 text-soft">Спільні проєкти, волонтерство команди, корпоративні благодійні вечори. <a class="link" href={u('/contacts')}>Напишіть нам</a>.</p></div>
      <div><h3 class="t-h3">Через Lions International</h3><p class="mt-3 text-soft">Міжнародні донори можуть підтримати Україну через фонд LCIF на lionsclubs.org.</p></div>
    </div>
  </section>
</Base>
<script>
  document.addEventListener('astro:page-load', () => {
    const b = document.querySelector<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    b.onclick = async () => {
      const v = document.querySelector('[data-iban]')!.textContent!.replace(/\s/g, '');
      try { await navigator.clipboard.writeText(v); b.textContent = 'Скопійовано'; } catch { b.textContent = 'Не вдалося скопіювати'; }
      setTimeout(() => (b.textContent = 'Скопіювати'), 2000);
    };
  });
</script>
