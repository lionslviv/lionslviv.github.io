---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import RequestForm from '../components/RequestForm.astro';
import { club } from '../data/site';
---
<Base title="Контакти" description="Контакти Lviv International Lions Club.">
  <PageHead title="Контакти" lead="Пишіть або телефонуйте щодо участі в зустрічах, партнерства і спільних проєктів. Можна англійською." />
  <section class="wrap grid gap-14 pb-24 md:grid-cols-[1fr_1.3fr]">
    <dl class="grid content-start gap-7 text-[19px]">
      <div><dt class="t-small">Email</dt><dd><a class="link" href={`mailto:${club.email}`}>{club.email}</a></dd></div>
      <div><dt class="t-small">Телефон</dt><dd><a class="link" href={`tel:${club.phone.replace(/\s/g, '')}`}>{club.phoneDisplay}</a></dd></div>
      <div><dt class="t-small">Зустрічі клубу</dt><dd>{club.meetingRule}</dd><dd class="text-soft">{club.meetingPlace}</dd></div>
      <div><dt class="t-small">Дистрикт</dt><dd>Lions Clubs International, {club.district}</dd></div>
      <div><dt class="t-small">Facebook</dt><dd><a class="link" href={club.social[0].href} target="_blank" rel="noopener">{club.facebookName}</a></dd></div>
      <div><dt class="t-small">Мова зустрічей</dt><dd>Англійська</dd></div>
    </dl>
    <RequestForm kind="contact" submitLabel="Надіслати повідомлення" messageLabel="Повідомлення" />
  </section>
</Base>
