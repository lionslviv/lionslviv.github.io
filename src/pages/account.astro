---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Кабінет" noindex>
  <section class="wrap pb-24 pt-[clamp(3rem,7vw,6rem)]" data-account>
    <div data-anon hidden class="space-y-5">
      <h1 class="t-h1">Кабінет</h1>
      <p class="t-lead">Увійдіть, щоб побачити кабінет.</p>
      <a href={u('/login')} class="btn btn-blue">Увійти</a>
    </div>
    <div data-auth hidden>
      <p class="text-soft" data-role></p>
      <h1 class="t-h1 mt-2" data-name></h1>
      <div class="mt-12 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
        <form class="panel grid gap-5 p-8" data-profile>
          <h2 class="t-h3">Мій профіль</h2>
          <div class="field"><label for="p-name">Ім’я та прізвище</label><input id="p-name" name="name" class="input" required /></div>
          <div class="field"><label for="p-field">Професія або сфера</label><input id="p-field" name="field" class="input" /></div>
          <div class="field"><label for="p-bio">Коротко про себе <span class="text-soft">(до 300 символів)</span></label><textarea id="p-bio" name="bio" class="textarea" maxlength="300"></textarea></div>
          <div class="field"><label for="p-quote">Чому я в Lions</label><input id="p-quote" name="quote" class="input" maxlength="140" /></div>
          <label class="check"><input type="checkbox" name="isPublic" /> <span>Показувати мій профіль на сайті. Телефон і email бачать лише члени клубу.</span></label>
          <div class="flex items-center gap-4"><button class="btn btn-blue" type="submit">Зберегти профіль</button><p class="text-[15px]" role="status" data-saved></p></div>
        </form>
        <div class="grid content-start gap-6">
          <div class="panel p-8" data-members-only>
            <h2 class="t-h3">Мої зустрічі</h2>
            <p class="mt-2 text-soft">Закриті збори клубу і ваші відповіді RSVP.</p>
            <a href={u('/events')} class="btn btn-quiet btn-sm mt-5">Розклад подій</a>
          </div>
          <div class="panel p-8" data-members-only>
            <h2 class="t-h3">Додати фото</h2>
            <p class="mt-2 text-soft">Фото з події потрапляють редакторам на модерацію. Ми стискаємо їх і прибираємо геолокацію автоматично.</p>
            <label class="btn btn-quiet btn-sm mt-5 cursor-pointer">Обрати фото<input type="file" accept="image/*" multiple class="sr-only" data-upload /></label>
            <p class="t-small mt-3" data-upload-note></p>
          </div>
          <button class="btn btn-ghost w-fit" data-logout>Вийти</button>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  import { getUser, updateUser, signOut, roleLabel, can } from '../scripts/store';
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-account]');
    if (!root) return;
    const user = getUser();
    (root.querySelector('[data-anon]') as HTMLElement).hidden = !!user;
    (root.querySelector('[data-auth]') as HTMLElement).hidden = !user;
    if (!user) return;
    root.querySelector('[data-role]')!.textContent = roleLabel[user.role];
    root.querySelector('[data-name]')!.textContent = user.name;
    root.querySelectorAll<HTMLElement>('[data-members-only]').forEach((el) => (el.hidden = !can.memberArea(user)));
    const f = root.querySelector<HTMLFormElement>('[data-profile]')!;
    (f.elements.namedItem('name') as HTMLInputElement).value = user.name;
    (f.elements.namedItem('field') as HTMLInputElement).value = user.field ?? '';
    (f.elements.namedItem('bio') as HTMLTextAreaElement).value = user.bio ?? '';
    (f.elements.namedItem('quote') as HTMLInputElement).value = user.quote ?? '';
    (f.elements.namedItem('isPublic') as HTMLInputElement).checked = !!user.isPublic;
    f.onsubmit = (e) => {
      e.preventDefault();
      const d = new FormData(f);
      updateUser({ name: String(d.get('name')), field: String(d.get('field')), bio: String(d.get('bio')), quote: String(d.get('quote')), isPublic: d.get('isPublic') === 'on' });
      root.querySelector('[data-name]')!.textContent = String(d.get('name'));
      root.querySelector('[data-saved]')!.textContent = 'Профіль збережено.';
    };
    const up = root.querySelector<HTMLInputElement>('[data-upload]');
    if (up) up.onchange = () => { root.querySelector('[data-upload-note]')!.textContent = `${up.files?.length ?? 0} фото надіслано на модерацію (демо: файли не завантажуються).`; };
    root.querySelector<HTMLButtonElement>('[data-logout]')!.onclick = () => { signOut(); location.href = import.meta.env.BASE_URL; };
  });
</script>
