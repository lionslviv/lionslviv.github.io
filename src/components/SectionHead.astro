---
import { u } from '../lib/url';
interface Props { title: string; lead?: string; href?: string; linkLabel?: string; class?: string }
const { title, lead, href, linkLabel, class: cls = '' } = Astro.props;
---
<div class={`mb-10 flex flex-col gap-4 md:mb-14 md:flex-row md:items-end md:justify-between ${cls}`}>
  <div class="max-w-[46rem] space-y-3">
    <h2 class="t-h2">{title}</h2>
    {lead && <p class="t-lead">{lead}</p>}
  </div>
  {href && <a href={u(href)} class="link shrink-0 text-[17px]">{linkLabel}</a>}
</div>
