---
import Wordmark from './Wordmark.astro';
import { nav } from '../data/site';
import { DEMO } from '../data/site';
import { u, isActive } from '../lib/url';
const path = Astro.url.pathname;
---
{DEMO && (
  <div class="bg-[var(--color-gold-soft)] text-[#5c4700] dark:bg-[#2a2200] dark:text-[#f3d97a]">
    <p class="wrap py-2 text-center text-[13.5px] font-[520]">
      Демо-версія сайту. Контент умовний.{' '}
      <a href={u('/login')} class="underline underline-offset-2">Увійти як редактор</a>, щоб спробувати адмінку.
    </p>
  </div>
)}
<header class="site-header" transition:persist>
  <a href="#main" class="sr-only-focusable absolute left-3 top-3 z-50 rounded-lg bg-white px-3 py-2 text-black">Перейти до змісту</a>
  <div class="wrap flex h-[60px] items-center justify-between gap-4 sm:gap-6">
    <Wordmark />
    <nav aria-label="Головна навігація" class="hidden items-center gap-7 lg:flex">
      {nav.map((n) => (
        <a href={u(n.href)} class="nav-link" aria-current={isActive(path, n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={u('/login')} class="nav-link hidden sm:inline-block" data-auth-chip>Увійти</a>
      <a href={u('/support')} class="btn btn-gold btn-sm">Підтримати</a>
      <button type="button" class="grid h-10 w-10 place-items-center rounded-full lg:hidden" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="lg:hidden" hidden data-menu>
    <nav class="wrap flex flex-col gap-1 pb-6 pt-2" aria-label="Мобільна навігація">
      {nav.map((n) => (
        <a href={u(n.href)} class="py-2.5 text-[26px] font-[680] tracking-[-0.02em]" style="font-stretch:110%">{n.label}</a>
      ))}
      <a href={u('/join')} class="py-2.5 text-[26px] font-[680] tracking-[-0.02em]" style="font-stretch:110%">Приєднатися</a>
      <a href={u('/login')} class="mt-3 text-[17px] text-soft" data-auth-chip>Увійти</a>
    </nav>
  </div>
</header>

<script>
  import { getUser, roleLabel, can } from '../scripts/store';
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  function paintAuth() {
    const user = getUser();
    document.querySelectorAll<HTMLAnchorElement>('[data-auth-chip]').forEach((a) => {
      if (!user) { a.textContent = 'Увійти'; a.href = `${base}/login`; return; }
      a.textContent = can.admin(user) ? 'Адмінка' : 'Кабінет';
      a.href = `${base}${can.admin(user) ? '/admin' : '/account'}`;
      a.title = `${user.name}: ${roleLabel[user.role]}`;
    });
  }

  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const open = menu.hidden;
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    });
  }

  document.addEventListener('astro:page-load', () => {
    paintAuth();
    initMenu();
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (menu) menu.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
    // активний пункт меню (шапка persist між сторінками)
    const p = location.pathname.replace(base, '').replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Головна навігація"] a').forEach((a) => {
      const h = a.getAttribute('href')!.replace(base, '').replace(/\/$/, '');
      if (p === h || p.startsWith(h + '/')) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
  });
  window.addEventListener('llp:change', paintAuth);
</script>
