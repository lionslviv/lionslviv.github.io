---
import Wordmark from './Wordmark.astro';
import { nav, DEMO } from '../data/site';
import { isActive } from '../lib/url';
import { langFromUrl, t, lp, switchPath } from '../i18n';
const path = Astro.url.pathname;
const lang = langFromUrl(Astro.url);
const T = t(lang);
const other = lang === 'en' ? 'uk' : 'en';
const otherHref = switchPath(path, other);
---
{DEMO && (
  <div class="bg-[var(--color-gold-soft)] text-[#5c4700] dark:bg-[#2a2200] dark:text-[#f3d97a]">
    <p class="wrap py-2 text-center text-[13.5px] font-[520]">
      {T.demoBanner}{' '}
      <a href={lp(lang, '/login')} class="underline underline-offset-2">{T.demoBannerLink}</a> {T.demoBannerTail}
    </p>
  </div>
)}
<header class="site-header" transition:persist={`site-header-${lang}`}>
  <a href="#main" class="sr-only-focusable absolute left-3 top-3 z-50 rounded-lg bg-white px-3 py-2 text-black">{T.skip}</a>
  <div class="wrap flex h-[60px] items-center justify-between gap-2 sm:gap-6">
    <Wordmark />
    <nav aria-label={lang === 'uk' ? 'Головна навігація' : 'Main navigation'} class="hidden items-center gap-5 whitespace-nowrap lg:flex xl:gap-7" data-main-nav>
      {nav.map((n) => (
        <a href={lp(lang, n.href)} class="nav-link" aria-current={isActive(path.replace(/^(.*?)\/uk(?=\/|$)/, '$1'), n.href) ? 'page' : undefined}>{T.nav[n.key]}</a>
      ))}
    </nav>
    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a href={otherHref} class="lang-switch !hidden sm:!inline-grid" hreflang={other} lang={other} aria-label={T.lang.switchTo} title={T.lang.switchTo} data-lang-switch>{T.lang.short}</a>
      <a href={lp(lang, '/login')} class="nav-link hidden sm:inline-block" data-auth-chip>{T.signIn}</a>
      <a href={lp(lang, '/support')} class="btn btn-gold btn-sm max-sm:!px-3.5 max-sm:!text-[14px]">{T.support}</a>
      <button type="button" class="grid h-10 w-10 place-items-center rounded-full lg:hidden" aria-label={T.menu} aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="lg:hidden" hidden data-menu>
    <nav class="wrap flex flex-col gap-1 pb-6 pt-2" aria-label={T.menu}>
      {nav.map((n) => (
        <a href={lp(lang, n.href)} class="py-2.5 text-[26px] font-[680] tracking-[-0.02em]" style="font-stretch:110%">{T.nav[n.key]}</a>
      ))}
      <a href={lp(lang, '/join')} class="py-2.5 text-[26px] font-[680] tracking-[-0.02em]" style="font-stretch:110%">{T.join}</a>
      <a href={lp(lang, '/login')} class="mt-3 py-2 text-[17px] text-soft" data-auth-chip>{T.signIn}</a>
      <a href={otherHref} class="py-2 text-[17px] text-soft" hreflang={other} lang={other} data-lang-switch>{T.lang.switchTo}</a>
    </nav>
  </div>
</header>

<script>
  import { cachedProfile, getProfile, displayName, can } from '../scripts/api';
  import { ct, cprefix } from '../scripts/i18n';
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  function paintAuth(user = cachedProfile()) {
    const T = ct();
    const pre = cprefix();
    document.querySelectorAll<HTMLAnchorElement>('[data-auth-chip]').forEach((a) => {
      if (!user) { a.textContent = T.signIn; a.href = `${pre}/login`; a.removeAttribute('title'); return; }
      a.textContent = can.admin(user) ? T.admin : T.account;
      a.href = `${pre}${can.admin(user) ? '/admin' : '/account'}`;
      a.title = `${displayName(user)}: ${T.roles[user.role]}`;
    });
  }
  const refreshAuth = () => getProfile().then((p) => paintAuth(p));

  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const open = menu.hidden;
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    });
  }

  // Перемикач мови веде на ту саму сторінку іншою мовою (шапка persist, тож оновлюємо href)
  function paintSwitch() {
    const uk = document.documentElement.lang === 'uk';
    let p = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
    p = p.replace(/^\/uk(?=\/|$)/, '') || '/';
    if (/^\/(404|styleguide|og-card)(\/|\.html)?$/.test(p) || document.title.startsWith('Page not found')) p = '/';
    const target = `${base}${uk ? '' : '/uk'}${p === '/' && !uk ? '' : p}` || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => { a.href = (target + location.search) || '/'; });
    try { localStorage.setItem('llp.lang', uk ? 'uk' : 'en'); } catch { /* ignore */ }
  }

  document.addEventListener('astro:page-load', () => {
    paintAuth();
    refreshAuth();
    initMenu();
    paintSwitch();
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (menu) menu.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
    // активний пункт меню (шапка persist між сторінками)
    const p = location.pathname.replace(base, '').replace(/^\/uk(?=\/|$)/, '').replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-main-nav] a').forEach((a) => {
      const h = a.getAttribute('href')!.replace(base, '').replace(/^\/uk(?=\/|$)/, '').replace(/\/$/, '');
      if (h && (p === h || p.startsWith(h + '/'))) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
  });
  window.addEventListener('llp:change', () => paintAuth());
</script>
