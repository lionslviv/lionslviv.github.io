---
// Коментарі: таблиця comments у Supabase з RLS, від користувачів ідуть на модерацію.
import { langFromUrl, t, lp } from '../i18n';
interface Props { target: string }
const { target } = Astro.props;
const lang = langFromUrl(Astro.url);
const C = t(lang).comments;
---
<section class="wrap-narrow border-t border-[var(--line)] py-14" data-comments={target} aria-labelledby="comments-title">
  <h2 id="comments-title" class="t-h3">{C.title}</h2>
  <ol class="mt-8 grid gap-6" data-list></ol>
  <p class="mt-6 text-soft" data-empty hidden>{C.empty}</p>

  <div class="mt-10" data-guest hidden>
    <p class="panel p-6 text-[17px]">{C.guest} <a class="link" href={lp(lang, '/login')}>{t(lang).signIn}</a></p>
  </div>

  <form class="mt-10 grid gap-4" data-form hidden>
    <div class="field">
      <label for={`c-${target}`}>{C.label}</label>
      <textarea id={`c-${target}`} name="body" class="textarea" maxlength="1500" required placeholder={C.placeholder}></textarea>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <button class="btn btn-blue" type="submit">{C.submit}</button>
      <p class="t-small" data-note></p>
    </div>
  </form>
</section>

<script>
  import { getProfile, comments, addComment, esc } from '../scripts/api';
  import { ct, cfmt } from '../scripts/i18n';

  async function render(root: HTMLElement) {
    const target = root.dataset.comments!;
    const [user, list] = await Promise.all([getProfile(), comments(target)]);
    const visible = list.filter((c) => c.status === 'approved' || (user && c.author_id === user.id && c.status === 'pending'));
    const ol = root.querySelector('[data-list]')!;
    ol.innerHTML = visible.map((c) => `
      <li class="grid grid-cols-[44px_1fr] gap-4">
        <span class="grid h-11 w-11 place-items-center rounded-full bg-[var(--bg-alt)] text-[15px] font-[680] text-[var(--accent)]">${esc((c.author_name || '?').slice(0, 1).toUpperCase())}</span>
        <div>
          <p class="text-[15px]"><span class="font-[640]">${esc(c.author_name || '')}</span> <span class="text-soft">${cfmt(c.created_at)}</span>
          ${c.status === 'pending' ? `<span class="badge badge-gold ml-2">${ct().moderation}</span>` : ''}</p>
          <p class="mt-1 whitespace-pre-line">${esc(c.body)}</p>
        </div>
      </li>`).join('');
    (root.querySelector('[data-empty]') as HTMLElement).hidden = visible.length > 0;
    (root.querySelector('[data-guest]') as HTMLElement).hidden = !!user;
    (root.querySelector('[data-form]') as HTMLElement).hidden = !user;
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-comments]').forEach((root) => {
      render(root);
      const form = root.querySelector<HTMLFormElement>('[data-form]')!;
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = (new FormData(form).get('body') as string).trim();
        if (body.length < 2) return;
        const note = root.querySelector('[data-note]')!;
        try {
          const st = await addComment(root.dataset.comments!, body);
          form.reset();
          note.textContent = st === 'pending' ? ct().commentPending : ct().commentPublished;
          render(root);
        } catch (err) { note.textContent = `${ct().sendError} (${(err as Error).message})`; }
      });
    });
  }
  document.addEventListener('astro:page-load', init);
  window.addEventListener('llp:change', () => document.querySelectorAll<HTMLElement>('[data-comments]').forEach((r) => render(r)));
</script>
