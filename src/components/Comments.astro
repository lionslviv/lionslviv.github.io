---
// Коментарі. Демо: localStorage. Продакшн: таблиця comments у Supabase з RLS.
import { u } from '../lib/url';
interface Props { target: string }
const { target } = Astro.props;
---
<section class="wrap-narrow border-t border-[var(--line)] py-14" data-comments={target} aria-labelledby="comments-title">
  <h2 id="comments-title" class="t-h3">Коментарі</h2>
  <ol class="mt-8 grid gap-6" data-list></ol>
  <p class="mt-6 text-soft" data-empty hidden>Коментарів ще немає. Поставте перше запитання.</p>

  <div class="mt-10" data-guest hidden>
    <p class="panel p-6 text-[17px]">Коментувати можуть авторизовані користувачі. <a class="link" href={u('/login')}>Увійти</a></p>
  </div>

  <form class="mt-10 grid gap-4" data-form hidden>
    <div class="field">
      <label for={`c-${target}`}>Ваш коментар</label>
      <textarea id={`c-${target}`} name="body" class="textarea" maxlength="1500" required placeholder="Що хочете запитати чи додати?"></textarea>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <button class="btn btn-blue" type="submit">Надіслати коментар</button>
      <p class="t-small" data-note></p>
    </div>
  </form>
</section>

<script>
  import { getUser, comments, addComment, esc, fmtDate } from '../scripts/store';

  function render(root: HTMLElement) {
    const target = root.dataset.comments!;
    const user = getUser();
    const list = comments().filter((c) => c.target === target && (c.status === 'approved' || (user && c.author === user.name && c.status === 'pending')));
    const ol = root.querySelector('[data-list]')!;
    ol.innerHTML = list.map((c) => `
      <li class="grid grid-cols-[44px_1fr] gap-4">
        <span class="grid h-11 w-11 place-items-center rounded-full bg-[var(--bg-alt)] text-[15px] font-[680] text-[var(--accent)]">${esc(c.author.slice(0, 1))}</span>
        <div>
          <p class="text-[15px]"><span class="font-[640]">${esc(c.author)}</span> <span class="text-soft">${fmtDate(c.at)}</span>
          ${c.status === 'pending' ? '<span class="badge badge-gold ml-2">на модерації</span>' : ''}</p>
          <p class="mt-1 whitespace-pre-line">${esc(c.body)}</p>
        </div>
      </li>`).join('');
    (root.querySelector('[data-empty]') as HTMLElement).hidden = list.length > 0;
    (root.querySelector('[data-guest]') as HTMLElement).hidden = !!user;
    (root.querySelector('[data-form]') as HTMLElement).hidden = !user;
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-comments]').forEach((root) => {
      render(root);
      const form = root.querySelector<HTMLFormElement>('[data-form]')!;
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const body = (new FormData(form).get('body') as string).trim();
        if (body.length < 2) return;
        const c = addComment(root.dataset.comments!, body);
        form.reset();
        root.querySelector('[data-note]')!.textContent = c.status === 'pending'
          ? 'Коментар надіслано. Він з’явиться після модерації.'
          : 'Коментар опубліковано.';
        render(root);
      });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
