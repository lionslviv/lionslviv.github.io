---
import Wordmark from './Wordmark.astro';
import BrandAsset from './BrandAsset.astro';
import { club, nav, navSecondary } from '../data/site';
import { u } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="bg-[var(--color-lions-deep)] text-white">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div class="space-y-5">
      <Wordmark inverse />
      <p class="max-w-[34ch] text-[15px] text-white/70">
        Клуб Lions International у Львові. {club.district}. Ми служимо громаді там, де живемо.
      </p>
      <p class="text-[15px] text-white/70">{club.meetingRule}<br />{club.meetingPlace}</p>
    </div>
    <nav aria-label="Розділи сайту" class="grid content-start gap-2.5 text-[15px]">
      <p class="mb-1 font-[640] text-white">Клуб</p>
      {nav.map((n) => <a class="text-white/70 hover:text-white" href={u(n.href)}>{n.label}</a>)}
    </nav>
    <nav aria-label="Корисне" class="grid content-start gap-2.5 text-[15px]">
      <p class="mb-1 font-[640] text-white">Долучитися</p>
      <a class="text-white/70 hover:text-white" href={u('/support')}>Підтримати</a>
      {navSecondary.map((n) => <a class="text-white/70 hover:text-white" href={u(n.href)}>{n.label}</a>)}
      <a class="text-white/70 hover:text-white" href={u('/events.ics')}>Календар подій (ICS)</a>
    </nav>
    <div class="grid content-start gap-2.5 text-[15px]">
      <p class="mb-1 font-[640] text-white">Зв’язок</p>
      <a class="text-white/70 hover:text-white" href={`mailto:${club.email}`}>{club.email}</a>
      {club.social.map((s) => <a class="text-white/70 hover:text-white" href={s.href} rel="noopener">{s.label}</a>)}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-[13px] text-white/55 md:flex-row md:justify-between">
      <div class="flex flex-wrap items-center gap-4">
        <BrandAsset name="signature-lci-white" alt="Lions Clubs International" height={28} />
        <p>© {year} {club.name}. Член Lions Clubs International.</p>
      </div>
      <p>Назви та емблеми Lions є торговельними марками Lions Clubs International.</p>
    </div>
  </div>
</footer>
