---
import Wordmark from './Wordmark.astro';
import BrandAsset from './BrandAsset.astro';
import { club, nav, navSecondary } from '../data/site';
import { u } from '../lib/url';
import { langFromUrl, t, lp, tr } from '../i18n';
const lang = langFromUrl(Astro.url);
const T = t(lang);
const year = new Date().getFullYear();
// Посилання на форму побажань передає сторінку, з якої прийшла людина
const here = Astro.url.pathname;
const feedbackHref = `${lp(lang, '/feedback')}/${/\/feedback\/?$/.test(here) ? '' : `?page=${encodeURIComponent(here)}`}`;
---
<footer class="bg-[var(--color-lions-deep)] text-white">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div class="space-y-5">
      <Wordmark inverse />
      <p class="max-w-[34ch] text-[15px] text-white/70">
        {tr(lang, club.about)}
      </p>
      <p class="text-[15px] text-white/70">{tr(lang, club.meetingRule)}<br />{tr(lang, club.meetingPlace)}</p>
    </div>
    <nav aria-label={T.footerClub} class="grid content-start gap-1 text-[16px] sm:gap-2.5 sm:text-[15px]">
      <p class="mb-1 font-[640] text-white">{T.footerClub}</p>
      {nav.map((n) => <a class="py-1 text-white/70 hover:text-white sm:py-0" href={lp(lang, n.href)}>{T.nav[n.key]}</a>)}
    </nav>
    <nav aria-label={T.footerJoin} class="grid content-start gap-1 text-[16px] sm:gap-2.5 sm:text-[15px]">
      <p class="mb-1 font-[640] text-white">{T.footerJoin}</p>
      <a class="py-1 text-white/70 hover:text-white sm:py-0" href={lp(lang, '/support')}>{T.support}</a>
      {navSecondary.map((n) => <a class="py-1 text-white/70 hover:text-white sm:py-0" href={lp(lang, n.href)}>{n.key === 'join' ? T.join : T.nav[n.key]}</a>)}
      <a class="py-1 text-white/70 hover:text-white sm:py-0" href={u(lang === 'uk' ? '/uk/events.ics' : '/events.ics')}>{T.footerCalendar}</a>
      <a class="py-1 text-white/70 hover:text-white sm:py-0" href={feedbackHref}>{T.footerFeedback}</a>
    </nav>
    <div class="grid content-start gap-1 text-[16px] sm:gap-2.5 sm:text-[15px]">
      <p class="mb-1 font-[640] text-white">{T.footerContact}</p>
      <a class="py-1 text-white/70 hover:text-white sm:py-0" href={`mailto:${club.email}`}>{club.email}</a>
      <a class="py-1 text-white/70 hover:text-white sm:py-0" href={`tel:${club.phone.replace(/\s/g, '')}`}>{club.phoneDisplay}</a>
      {club.social.map((s) => <a class="py-1 text-white/70 hover:text-white sm:py-0" href={s.href} rel="noopener">{s.label}</a>)}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-[13px] text-white/55 md:flex-row md:justify-between">
      <div class="flex flex-wrap items-center gap-4">
        <BrandAsset name="signature-white" alt="Lions International" height={36} />
        <p>© {year} {club.name}. {T.footerMember}</p>
      </div>
      <p>{T.footerTm}</p>
    </div>
  </div>
</footer>
